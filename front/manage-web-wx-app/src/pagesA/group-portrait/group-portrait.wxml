<view class="group-portrait">
    <!-- 群信息 -->
    <view class="card">
        <view class="group-name">{{ info.chat_info.name || "-" }}</view>
        <view class="group-admin">
          <view class="tag">
            <view class="tag-text">群主</view>
          </view>
          {{ info.chat_info.owner || "-" }}
        </view>
        <view class="group-create-time">
          建群时间 {{ info.chat_info.create_time || "-" }}
        </view>
    </view>
       
    <!-- 客户概述 -->
    <view class="card">
        <view class="title">客户概述</view>

        <view class="customer-census">
            <view wx:for="{{c_summary_list}}" wx:key="index" class="customer-census-item">
                <view class="num">{{info.target[item.prop] || 0}}</view>

                <view class="tip">
                    {{ item.name }}
                    <popover placement="bottom" theme="light">
                        <view class="popover-action">{{item.actions}}</view>
                        <view slot="reference">
                            <view class="tip-icon"></view>
                        </view>
                    </popover>
                </view>
            </view>
        </view>
        
    </view>

    <!-- 群会员统计 -->
    <view class="card">
        <view class="title">群会员统计</view>
         <view class="group-census">
            <view wx:for="{{g_summary_list}}" wx:key="index" class="group-census-item">
                <view class="num">{{info.target[item.prop] || 0}}</view>
                  <view class="tip">
                    {{ item.name }}
                    <popover placement="bottom" theme="light">
                        <view class="popover-action">{{item.actions}}</view>
                        <view slot="reference">
                            <view class="tip-icon"></view>
                        </view>
                    </popover>
                </view>
            </view>
        </view>

        <!-- 统计图 -->
        <view>
             <chart chart-class="charts" option="{{ options }}"></chart>
        </view>
    </view>

    <!-- 群成员列表 -->
    <view class="card">
        <tabs 
            custom-tab-header="custom-tab-header"
            custom-tab-item="custom-tab-item"
            list="{{tabList}}" 
            currentIndex="{{tabIndex}}" 
            bind:changeTab="tabChange">

            <userList list="{{list}}" type="{{0}}" ownerId="{{info.chat_info.user_id}}" />

            <view class="open-btn" bindtap="goPersons">
              <view>
                查看更多
                <text class="arraw" />
              </view>
            </view>
        </tabs>
    </view>
</view>
<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
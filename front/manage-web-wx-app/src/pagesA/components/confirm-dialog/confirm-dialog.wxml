<view>
    <popup show="{{popShow}}">
        <view slot="content" class="wrap">
            <view class="header">
              提示
            </view>
              
            <view class="content">{{content}}</view>
            <view class="btn-group">
              
              <view class="cancel-btn" catchtap="cancelBtn">否</view>
              <view class="confirm-btn" catchtap="confirmBtn">是</view>
            </view>
        </view>
    </popup>
</view>

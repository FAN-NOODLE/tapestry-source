<view class="page-invite-check flex-center">
    <view wx:if="{{!isLoading}}">
        <view class="page-invite-check-content">
            <view class="page-invite-check-content-letter" wx:if="{{detail.style_type === 1}}">
                <view class="page-invite-check-content-letter-title">尊敬的顾客：{{detail.user_name || '--'}}</view>
                <view class="page-invite-check-content-letter-write">{{detail.send_content}}</view>
                <view class="page-invite-check-content-letter-sign">
                    您的专属顾问：{{detail.member_name}}
                </view>
            </view>
            <view class="page-invite-check-content-backgroundImg">
                <image class="page-invite-check-content-backgroundImg-image" src="{{detail.background_url}}" mode="widthFix" lazy-load="{{true}}" />
            </view>
            <view class="page-invite-check-content-letter m-t-25" wx:if="{{detail.style_type === 2}}">
                <view class="page-invite-check-content-letter-title">尊敬的顾客：{{detail.user_name || '--'}}</view>
                <view class="page-invite-check-content-letter-write">{{detail.send_content}}</view>
                <view class="page-invite-check-content-letter-sign">
                    您的专属顾问：{{detail.member_name}}
                </view>
            </view>
            <image class="page-invite-check-content-bg" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.2/weclient/invite_bg.png" lazy-load="{{true}}" mode="aspectFill" />
        </view>
        <view class="page-invite-check-subscribe" >
            <view class="page-invite-check-subscribe-title">
                <view class="page-invite-check-subscribe-title-dec"></view>
                <view class="page-invite-check-subscribe-title-main">提前预约到店 尊享专属服务</view>
                <view class="page-invite-check-subscribe-title-dec"></view>
            </view>
            <view class="page-invite-check-subscribe-content">
                <view class="page-invite-check-subscribe-content-item">
                    <view class="page-invite-check-subscribe-content-item-label">关联预约服务：</view>
                    <view class="page-invite-check-subscribe-content-item-value">
                        {{detail.reserve_service_name}}
                    </view>
                </view>
                <view wx:if="{{detail.reserve_time}}" class="page-invite-check-subscribe-content-item {{detail.reserve_order_id && 'reserve-mg'}}">
                    <view class="page-invite-check-subscribe-content-item-label">到店时间：</view>    
                    <view class="reserve-time">{{detail.reserve_time}}</view>
                </view>
            </view>
        </view>
    </view>
</view>
<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
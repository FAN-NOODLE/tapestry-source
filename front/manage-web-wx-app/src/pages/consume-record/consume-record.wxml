<view class="pages-consume-record" bindtap="closeSelect">
	<!-- 客户信息 -->
	<view class="customer-info">
		<view class="customer-info-title">客户信息</view>
		<view class="customer-info-content">
			<view class="info-item">
				<view class="info-item-label">会员卡号</view>
				<view class="info-item-content">{{userDetail.membership}}</view>
			</view>
			<view class="info-item">
				<view class="info-item-label">最近购买日期</view>
				<view class="info-item-content">{{lastPurchaseTime}}</view>
			</view>
			<view class="info-item">
				<view class="info-item-label">近12个月购买次数</view>
				<view class="info-item-content">{{L12MPurchaseCount}}</view>
			</view>
			<view class="info-item">
				<view class="info-item-label">近12个月购买金额</view>
				<view class="info-item-content">{{L12MPurchaseAmount}}</view>
			</view>
			<view class="collapse" wx:if="{{expand}}">
				<view class="info-item">
					<view class="info-item-label">当前可用积分</view>
					<view class="info-item-content">{{userDetail.total_valid_points}}</view>
				</view>
				<view class="info-item">
					<view class="info-item-label">升级所需积分</view>
					<view class="info-item-content">{{userDetail.upgrade_need_points}}</view>
				</view>
				<view class="info-item">
					<view class="info-item-label">最近升级时间</view>
					<view class="info-item-content">{{userDetail.upgrade_date_time}}</view>
				</view>
				<view class="info-item">
					<view class="info-item-label">会籍发行日</view>
					<view class="info-item-content">{{userDetail.vip_status.issueDate}}</view>
				</view>
				<view class="info-item">
					<view class="info-item-label">会籍到期日</view>
					<view class="info-item-content">{{userDetail.vip_status.expiryDate}}</view>
				</view>
				<view class="info-item">
					<view class="info-item-label">发行店铺</view>
					<view class="info-item-content">{{userDetail.vip_status.issueShop}}</view>
				</view>
				<view class="info-item">
					<view class="info-item-label">居住城市</view>
					<view class="info-item-content">{{userDetail.city}}</view>
				</view>
			</view>
			<view class="expand" catchtap="expand">
				{{ expand ? '收起' : '展开' }}
				<image class="icon {{expand ? 'rotate' : ''}}" src="https://cdn-cos.coach.com.cn/static/wxapp/common/down-icon.png" />
			</view>
		</view>
	</view>
	<!-- 搜索 -->
	<view class="search">
		<view class="search-choose" id="chooseArea" catchtap="showSelectArea">
			<view class="search-choose-item">{{selectList[selectIndex].value}}</view>
			<image class="image" src="https://img-crs.vchangyi.com/store-manage-wxapp/compass_triangle.png" />
		</view>
		<view class="search-content">
			<image class="image" src="https://cdn-cos.coach.com.cn/uploads/2024/v4.1.3/icon_search.png" />
			<input bindblur="inputBlur" class="search-placeholder" placeholder="请输入{{selectList[selectIndex].value}}" />
		</view>
		<view class="select-area" wx:if="{{showSelect}}">
			<view
			 class="select-area-item {{selectIndex == index ? 'active':''}}"
			 data-index="{{index}}"
			 wx:for="{{selectList}}"
			 catchtap="chooseSelect"
			 wx:key="key"
			>
				<image class="image" wx:if="{{selectIndex == index}}" src="https://cdn-cos.coach.com.cn/uploads/2023/v3.2.0.1/duigou.png" />
				{{item.value}}
			</view>
		</view>
	</view>
	<!-- 消费记录 -->
	<view class="record-list">
		<view class="list-item" wx:for="{{recordList}}" wx:key="order_no">
			<view class="top-order-num">
				<view class="top-order-num-label">订单编号:</view>
				<view class="top-order-num-content">{{item.order_no}}</view>
			</view>
			<view class="list-content">
				<view class="list-content-image">
					<image
					 class="image"
					 src="{{item.sku_image}}"
					 data-index="{{index}}"
					 binderror="skuImgError"
					/>
				</view>
				<view class="list-content-content">
					<view class="content-item">
						<view class="content-item-label">商品名称:</view>
						<view class="content-item-content">{{item.sku_name}}</view>
					</view>
					<view class="content-item">
						<view class="content-item-label">款号:</view>
						<view class="content-item-content">{{item.style}}</view>
					</view>
					<view class="content-item">
						<view class="content-item-label">员工ID:</view>
						<view class="content-item-content">{{item.ssociate}}</view>
					</view>
					<view class="content-item">
						<view class="content-item-label">金额:</view>
						<view class="content-item-content">{{item.amount}}</view>
					</view>
					<view class="content-item">
						<view class="content-item-label">购买日期:</view>
						<view class="content-item-content">{{item.purchase_date_time}}</view>
					</view>
					<view class="content-item">
						<view class="content-item-label">店铺:</view>
						<view class="content-item-content">{{item.store_name}}</view>
					</view>
				</view>
			</view>
		</view>
	</view>
	<!-- 加载组件 -->
	<page-loading wx:if="{{showLoading}}" />
	<!-- 搜索空页面 -->
	<mp-empty wx:if="{{recordList.length == 0 && !showLoading}}" icon="customer" content="暂无搜索结果～" />
</view>


<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
<view class="select-date">
  <view class="week">
    <view class="week-item" wx:for="{{week}}" wx:key="index">{{item}}</view>
  </view>
  <view class="month-wrap">
    <view class="month" wx:for="{{dateList}}" wx:for-index="index" wx:for-item="item" wx:key="index" data-index="{{index}}">
      <view class="month-title">
        <view class="month-title-content">{{item.year}}年{{item.month}}月</view>
      </view>
      <view class="month-days">
        <view class="day {{subItem.is_current?'day-active':''}} {{subItem.task_count?'':'isTask'}} {{isFlash && (subItem.year+subItem.month+subItem.day) === currentLocaldate ?'curDateFlash':''}}" wx:for="{{item.days}}" wx:for-index="subIndex" wx:for-item="subItem" wx:key="subIndex" data-item="{{subItem}}" catchtap="selectDateFn">
          <view class="day-num"  id="{{subItem.is_current?'day-active':''}}" >{{subItem.day}}</view>
          <view wx:if="{{(subItem.year+subItem.month+subItem.day) === currentLocaldate}}" class="day-word" id="day-word">今日</view>
        </view>
      </view>
    </view>
  </view>
   <!-- 返回今日 -->
  <view class="go-today" wx:if="{{shouldFiexdSelect}}" bindtap="goBackToday">
    <image
      src="https://img-crs.vchangyi.com/store-manage-wxapp/go_today.png"
      mode="aspectFill"
    />
  </view>
</view>


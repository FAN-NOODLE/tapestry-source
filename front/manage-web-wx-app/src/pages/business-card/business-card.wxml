<view class="page-business-card">
  <!-- 名片图片 -->
  <image wx:if="{{!loading && poster}}" mode="aspectFill" class="business-card" src="{{poster}}"></image>
  <!-- 缺省页 -->
  <view wx:if="{{!loading && !poster}}" class="empty-wapper">
    <image class="icon" src="https://crs-prod-1251064102.cos.ap-shanghai.myqcloud.com/tapestry-wxapp/empty-user.png" />
    <view class="desc">您的导购名片未找到</view>
  </view>
  <!-- 保存按钮 -->
  <view wx:if="{{!loading && poster}}" class="btn-wrapper" bindtap="save">
    <image class="icon" src="../../images/coach/down.png" />
    <view class="title">保存至相册</view>
  </view>
  <!-- 刷新按钮 -->
  <view wx:if="{{!loading && !poster}}" class="btn-wrapper" bindtap="refresh">
    <image class="icon" src="../../images/customer/refresh.png" />
    <view class="title">刷新一下</view>
  </view>
</view>

<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
<view class="page-select-store" wx:if="{{!loading}}">
	<view class="" wx:if="{{list.length > 0}}">
		<view class="choose">选择门店</view>
		<view wx:for="{{list}}" wx:key="index">
			<store-model store="{{item}}" bindselect="select"></store-model>
		</view>
		<custom-loading isLoading="{{pageSet.loading}}" hasMore="{{pageSet.hasMore}}"></custom-loading>
	</view>
	<mp-empty wx:if="{{!pageSet.loading && list.length == 0}}" icon="store" content="当前暂无门店～" marginTop="143"></mp-empty>
</view>



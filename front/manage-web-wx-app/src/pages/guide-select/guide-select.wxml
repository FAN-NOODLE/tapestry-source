<view class="page-guide-select">
  <view class="top-fixed-box">
    <!-- 搜索模块 -->
    <view class="search-bar">
      <image class="icon-search" src="https://cdn-cos.coach.com.cn/uploads/2024/v4.1.3/icon_search.png" />
      <view class="input-box">
        <input class="code-ipt" placeholder-class="input-placeholder" value="{{ value }}" focus="{{true}}" placeholder="搜索导购姓名、手机号" maxlength="16" bindinput="onChange" />
      </view>
      <view class="search-cancel" wx:if="{{value}}" catchtap="clearValue">
        <image class="cancel-icon" src="https://cdn-cos.coach.com.cn/uploads/2024/v4.2.0/icon_clear.png" />
      </view>
    </view>
    <!-- 选择全部导购按钮 -->
    <view class="all-guide {{check_all==1 ? 'select-item':''}}" bindtap="selectAll">
      全部导购
      <view class="select-img-box" wx:if="{{check_all==1}}">
        <image class="select-img" src="https://img-crs.vchangyi.com/store-manage-wxapp/guide_check_select.png" />
      </view>
    </view>
  </view>
  <view wx:if="{{ searching }}" class="searching">加载中..</view>
  <view wx:else>
    <!-- 导购列表展示模块 -->
    <view class="guide-list-box" wx:if="{{ searchResult.length }}">
      <view class="item-list {{item.id == memberId ? 'select-item':''}}" wx:for="{{ searchResult }}" wx:key="index" bindtap="selectGuide" data-name="{{item.name}}" data-id="{{item.id}}">
        <view class="item-left">
          <text class="name ellipses">{{item.name}}</text>
          <text class="mobile">({{item.mobile}})</text>
          <view class="self" wx:if="{{item.myself}}">
            <image class="icon" src="https://img-crs.vchangyi.com/store-manage-wxapp/sy_partner_icon_self.png"></image>
            <text class="text">自己</text>
          </view>
          <view class="tag on-duty" wx:if="{{item.worker_status === 1}}">在岗</view>
          <view class="tag leaving" wx:else>离岗</view>
        </view>
        <view class="select-img-box" wx:if="{{item.id == memberId}}">
          <image class="select-img" src="https://img-crs.vchangyi.com/store-manage-wxapp/guide_check_select.png" />
        </view>
      </view>
    </view>
  </view>
  <!-- 空组件 -->
  <mp-empty wx:if="{{ready && !searchResult.length && value}}" slogan="{{currentEmptyText}}" icon="order" />
</view>

<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
<view class="page-customer-lost">
	<view class="navbar">
		<view class="nav-item {{active === 2 ? 'active' : ''}}" data-index="{{2}}" bindtap="changeActive">员工删除客户流失</view>
		<view class="nav-item {{active === 1 ? 'active' : ''}}" data-index="{{1}}" bindtap="changeActive">客户删除员工流失</view>
	</view>
	<view class="message-item">
		流失时间：{{showTime || '-'}}
	</view>
	<view class="message-item">
		流失总客户数：{{lost_total}}人
	</view>
	<view class="container">
		<picker bindchange="changeStore" value="{{index}}" range="{{options1}}" range-key="dp_name">
			<view class="picker">
				门店：<view class="select-wraper">{{selectStore}}</view>
			</view>
		</picker>
		<picker bindchange="changeBA" value="{{index}}" range="{{options2}}" range-key="username">
			<view class="picker">
				导购：<view class="select-wraper">{{selectBA}}</view>
			</view>
		</picker>
	</view>
	<view class="message-item">
		流失客户数：{{lost_count}}人
	</view>
	<!-- 顾客列表 -->
	<view class="customer-list {{customerCardShow? 'customer-acgtive' : ''}}">
		<view class="page-customer-card" wx:for="{{customerList}}" wx:key="index" wx:for-index="index">
			<view class="customer-card-contengt">
				<view class="customer-info">
					<view class="customer-avatar">
						<image class="img" src="{{item.avatar}}" preview="{{false}}"></image>
					</view>
					<view class="customer-content">
						<view class="content-top">
							<view class="name m-r-10" selectable="true">
								{{item.nick ? item.name+'（'+ item.nick +'）':item.name}}
							</view>
							<image wx:if="{{item.sex === 1 || item.sex===2}}" class="customer-gender" src="https://img-crs.vchangyi.com/store-manage-wxapp/{{item.sex === 1? 'icon_male.png' : 'icon_female.png'}}" />
							<view wx:if="{{item.sex === 1 || item.sex===2}}" class="gender-text">
								{{item.sex === 1?'男':'女'}}
							</view>
						</view>
						<!-- <view class="date">
							<view>{{item.name}} {{active === 2 ? 'BA删除好友' : '删除BA好友'}}</view>
						</view> -->
						<!-- 性别与电话 -->
						<view class="other">
							<image class="customer-tel" src="https://img-crs.vchangyi.com/store-manage-wxapp/icon_telephone.png" />
							<text class="tel-text" selectable="true">{{item.mobile?item.mobile:'-'}}</text>
						</view>
						<view class="system-label" catchtap="arrowClick" data-index="{{index}}" wx:if="{{item.tags.length>0}}">
							<view wx:for="{{item.tags}}" wx:key="index" wx:for-index="ind" class="system-label-box">
								{{item.name}}
							</view>
						</view>
					</view>
				</view>
			</view>
		</view>
		<!-- 空组件 -->
		<mp-empty wx:if="{{customerCardShow}}" slogan="暂无删除记录" icon="customer" />
		<!-- 到底提示 -->
		<view class="bottom-tip" wx:if="{{customerList.length > 0 && !hasMore }}">已经到底了~</view>
	</view>
</view>

<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
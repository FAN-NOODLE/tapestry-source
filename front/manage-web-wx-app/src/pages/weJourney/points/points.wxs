/** 初始x 可视宽度 scroll-box宽度 detail-container宽度 */
var startX = 0
var tWidth = 0
var sWidth = 0
var dWidth = 0

var moveX = 0
/** 最后一次left的位置 */
var lastLeft = 0
var current = 0

/** 手指触摸 */
function touchstart (event, ins) {
  var touch = event.touches[0] || event.changedTouches[0]
  /** 储存触摸位置 */
  startX = touch.pageX
  moveX = touch.pageX
  /** 获取可是宽度 及 .content元素宽度 */
  tWidth = parseInt(ins.selectComponent('.content').getComputedStyle(['width']).width)
  dWidth = parseInt(ins.selectComponent('.detail-container').getComputedStyle(['width']).width)
  sWidth = parseInt(ins.selectComponent('.scroll-box').getComputedStyle(['width']).width)
  /** 移除已有动画类 */
  ins.selectComponent('.scroll-box').removeClass('animation-left')
  ins.selectComponent('.detail-container').removeClass('animation-left')
}

function touchmove (event, ins) {
  var touch = event.touches[0] || event.changedTouches[0]
  var pageX = touch.pageX
  /**
   * 获取改变之后的left值
   * 滚动后为负值，且滚动距离不可超过tWidth - dWidth
   * 1.3为滚动距离为滑动距离的1.3倍
   */
  var left = Math.min(Math.max(tWidth - dWidth, (pageX - moveX) * 1.3 + lastLeft), 0)

  moveX = pageX
  lastLeft = left
  /** 为元素添加left */
  ins.selectComponent('.detail-container').setStyle({
    left: left + 'px'
  })

  /** 计算已滑动距离占总可滑动距离比例 */
  var ratio = left / (tWidth - dWidth)
  /** 计算.scroll-box需要移动的距离 */
  var sLeft = ratio * (tWidth - sWidth)

  ins.selectComponent('.scroll-box').setStyle({
    left: sLeft + 'px'
  })
}

/** 手指离开屏幕 判断上下元素是否对齐 并自动对齐 */
function touchend (event, ins, custom = false) {
  var touch = event.touches[0] || event.changedTouches[0]
  var pageX = touch.pageX
  /** 选取所有.info-container元素 */
  var allCom = ins.selectAllComponents('.info-container')
  var allLevelCom = ins.selectAllComponents('.level')
  setCurrentClass(ins)
  if (pageX - startX < 0 && current < allCom.length - 1) {
    current++
  } else if (pageX - startX > 0 && current > 0) {
    current--
  }
  setCurrentClass(ins)
  var left = 0
  var sLeft

  /** 如果是第一个，对齐不需要居中，left置为0 */
  if (current === 0) {
    left = 0
    sLeft = 0
    /** 如果是最后一个， 对齐不需要居中，left为可移动的最大距离 */
  } else if (current === allCom.length - 1) {
    left = tWidth - dWidth
    sLeft = tWidth - sWidth
  } else {
    var el = allCom[current].getBoundingClientRect()
    var elLevel = allLevelCom[current].getBoundingClientRect()
    /** 计算居中需要移动的距离 */
    var dec = el.left + el.width / 2 - tWidth / 2
    var decLevel = elLevel.left + elLevel.width / 2 - tWidth / 2
    /** 移动最小距离可居中对齐 */
    left = lastLeft - dec
    sLeft = lastLeft / (tWidth - dWidth) * (tWidth - sWidth) - decLevel
  }

  lastLeft = left
  ins.selectComponent('.detail-container').setStyle({
    left: left + 'px'
  }).addClass('animation-left')

  ins.selectComponent('.scroll-box').setStyle({
    left: sLeft + 'px'
  }).addClass('animation-left')
}

function foldTap (event, ins) {
  var index = event.currentTarget.dataset.index
  if (ins.selectAllComponents('.info-container>.content')[index].hasClass('fold')) {
    ins.selectAllComponents('.info-container>.content')[index].removeClass('fold').addClass('unfold')
  } else {
    ins.selectAllComponents('.info-container>.content')[index].removeClass('unfold').addClass('fold')
  }
}

function propObserver (newV, oldV, ownerIns, ins) {
  var height = ins.getBoundingClientRect().height
  if (height < 25) {
    ownerIns.selectAllComponents('.info-container>.content>.icon')[newV].setStyle({ display: 'none' })
  } else {
    ins.addClass('fold')
  }
}

function navTap (event, ins) {
  if (!event.instance.hasClass('active')) {
    ins.selectComponent('.active').removeClass('active')
    event.instance.addClass('active')
    ins.callMethod('navChange', event)
  }
}

function setCurrentClass (ins) {
  if (ins.selectAllComponents('.level-box>.level')[current].hasClass('not-obtain')) {
    ins.selectAllComponents('.level-box>.level')[current].removeClass('not-obtain').addClass('acquired')
  } else {
    ins.selectAllComponents('.level-box>.level')[current].removeClass('acquired').addClass('not-obtain')
  }
}

function currentChange (nv, ov, ins) {
  /* 页面初始化时不做任何操作 */
  if (nv === -1) return
  current = nv - 1 < 0 ? 0 : nv - 1
  /* 根据current值设置dom样式 */
  tWidth = parseInt(ins.selectComponent('.content').getComputedStyle(['width']).width)
  dWidth = parseInt(ins.selectComponent('.detail-container').getComputedStyle(['width']).width)
  sWidth = parseInt(ins.selectComponent('.scroll-box').getComputedStyle(['width']).width)
  var allCom = ins.selectAllComponents('.info-container')
  var allLevelCom = ins.selectAllComponents('.level')
  var left = 0
  var sLeft
  /** 如果是第一个，对齐不需要居中，left置为0 */
  if (current === 0) {
    left = 0
    sLeft = 0
    /** 如果是最后一个， 对齐不需要居中，left为可移动的最大距离 */
  } else if (current === allCom.length - 1) {
    left = tWidth - dWidth
    sLeft = tWidth - sWidth
  } else {
    var el = allCom[current].getBoundingClientRect()
    var elLevel = allLevelCom[current].getBoundingClientRect()
    /** 计算居中需要移动的距离 */
    var dec = el.left + el.width / 2 - tWidth / 2
    var decLevel = elLevel.left + elLevel.width / 2 - tWidth / 2
    /** 移动最小距离可居中对齐 */
    left = lastLeft - dec
    sLeft = lastLeft / (tWidth - dWidth) * (tWidth - sWidth) - decLevel
  }

  lastLeft = left
  ins.selectComponent('.detail-container').setStyle({
    left: left + 'px'
  }).addClass('animation-left')

  ins.selectComponent('.scroll-box').setStyle({
    left: sLeft + 'px'
  }).addClass('animation-left')

  setCurrentClass(ins)
}

function formatPoint (value) {
  if (value) {
    return Math.floor(value)
  }
  return 0
}

function getLevelIcon(index) {
  if (index <= 10) {
    return 'https://cdn-cos.coach.com.cn/uploads/2023/3.5.1/level/x.png'
  } else if (index <= 20) {
    return 'https://cdn-cos.coach.com.cn/uploads/2023/3.5.1/level/y.png'
  } else {
    return 'https://cdn-cos.coach.com.cn/uploads/2023/3.5.1/level/z.png'
  }
}
// todo:获取金币数量
function getCoinsNum(coins) {
  if (coins.indexOf('+') !== -1) {
    return '+' + coins.replace('+', '')
  } else if (coins.indexOf('-') !== -1) {
    return '-' + coins.replace('-', '')
  }
}
// todo:获取金币颜色
function getCoinsColor(coins) {
  if (coins.indexOf('+') !== -1) {
    return '#FF7E1C'
  } else if (coins.indexOf('-') !== -1) {
    return '#FFCD02'
  }
}

module.exports = {
  touchstart: touchstart,
  touchmove: touchmove,
  touchend: touchend,
  foldTap: foldTap,
  propObserver: propObserver,
  navTap: navTap,
  currentChange: currentChange,
  formatPoint: formatPoint,
  getLevelIcon: getLevelIcon,
  getCoinsColor: getCoinsColor,
  getCoinsNum: getCoinsNum
}

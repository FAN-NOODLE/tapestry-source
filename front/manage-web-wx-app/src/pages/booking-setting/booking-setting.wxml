<view class="booking-setting">
    <view class="booking-setting-content">
         <!-- 预约日期 -->
        <view class="search-box">
            <view class="search-left">预约日期:</view>
            <view class="search-right">
                <picker class="right-input" range="{{rangeList}}" bindchange="bindChange" value="{{searchTimeIndex}}">
                    <view>{{searchTime}}</view>
                </picker>
                <view  class="down-icon" />
            </view>
        </view>

        <!-- 表格 -->
        <table headers="{{tableHeader}}" bodySlot="{{true}}" needMsg="{{false}}" header-row-class-name="table-header">
            <view slot="body">
                <!-- 上午预约安排 -->
                <view class="second-header">上午预约安排</view>
                <view class="table-body">
                    <block wx:for-item="it" wx:for="{{ tableDataTop }}" wx:key="*this" wx:for-index="idx">
                        <view class="table-tr">
                            <view class="td" wx:for-item="head" wx:for="{{ tableHeader }}" wx:key="*this" style="width:{{ tableHeader[index].width ?  tableHeader[index].width + 'rpx' : '100%'}};">
                                <view wx:if="{{head.prop !== 'reserve_num' || (head.prop === 'reserve_num' && !isEdit)}}">
                                    {{it[head["prop"]]}}
                                </view>
                                <block wx:else>
                                    <input wx:if="{{!it.disabled}}" bindinput="inputNumber" type="number" maxlength="20" value="{{it['reserve_num']}}" data-index="{{idx}}" data-name="top" bindblur="peopleChange" />
                                    <view wx:else class="is-disabled">{{it['reserve_num']}}</view>
                                </block>
                            </view>
                        </view>
                    </block>
                </view>
                <!-- 下午预约安排 -->
                <view class="second-header">下午预约安排</view>
                <view class="table-body">
                    <block wx:for-item="it" wx:for="{{ tableDataBottom }}" wx:key="*this" wx:for-index="idx">
                        <view class="table-tr">
                            <view class="td" wx:for-item="head" wx:for="{{ tableHeader }}" wx:key="*this" style="width:{{ tableHeader[index].width ?  tableHeader[index].width + 'rpx' : '100%'}};">
                                <view wx:if="{{head.prop !== 'reserve_num' || (head.prop === 'reserve_num' && !isEdit)}}">
                                    {{it[head["prop"]]}}
                                </view>
                                <block wx:else>
                                    <input wx:if="{{!it.disabled}}" bindinput="inputNumber" type="number" maxlength="20" value="{{it['reserve_num']}}" data-index="{{idx}}" data-name="bottom" bindblur="peopleChange" />
                                    <view wx:else class="is-disabled">{{it['reserve_num']}}</view>
                                </block>
                            </view>
                        </view>
                    </block>
                </view>
            </view>
        </table>
    </view>
   

    <!-- 底部按钮 -->
    <view class="buttons {{isIPhoneX ? 'isIosBottom': ''}}">
        <button class="save" wx:if="{{!isEdit}}" bindtap="setEdit">编辑</button>
        <block wx:else>
            <button class="cancel" bindtap="cancel">取消</button>
            <button class="save" bindtap="saveTimeSetting">保存</button>
        </block>
    </view>
</view>
<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
<wxs module="tools">
  /** 处理金额 */
  function moneyFormat(money) {
    return '¥' + Math.floor(money) / 100
  }

  module.exports = {
    moneyFormat: moneyFormat
  }
</wxs>

<view class="page-achievements">
  <!-- 筛选 -->
  <view class="search-box">
    <!-- 时间选择器 -->
    <view class="search-time" >
      <view class="point-icon-boxs" wx:if="{{!dateVals.length}}">
        <view class="point-icon-box {{dateIndex == 0? 'd-none' : '' }}" bindtap="switchDate" data-type="left">
          <view class="point-icon"></view>
        </view>
      </view>
      <view class="time-text" bindtap="getDateSelect" wx:if="{{dateType=='month'&& !dateVals.length}}">{{monthList[dateIndex].label}}</view>
      <view class="time-text" bindtap="getDateSelect" wx:if="{{dateType=='year'&& !dateVals.length}}">{{yearList[dateIndex].label}}</view>
      <view class="time-text" bindtap="getDateSelect" wx:if="{{dateVals.length}}">{{dateVals[2]}}</view>
      <view class="point-icon-boxs" wx:if="{{!dateVals.length}}">
        <view class="point-icon-box  {{monthList[dateIndex].now==1?'d-none':''}}" bindtap="switchDate" data-type="right" wx:if="{{dateType=='month'}}">
          <view class="point-icon tf" wx:if="{{dateType=='month'}}"></view>
        </view>
        <view class="point-icon-box {{yearList[dateIndex].now==1?'d-none':''}}" bindtap="switchDate" data-type="right"  wx:if="{{dateType=='year'}}">
          <view class="point-icon tf "></view>
        </view>
     </view>
      <view class="point-icon-box point-icon-box-de" wx:if="{{dateVals.length}}" bindtap="deleteTime">
        <image class="point-icon-dete" src="{{closeIcon}}" alt="" />
      </view>
    </view>
    <!-- 门店选择 --> 
    <picker wx:if="{{tabValue !== 1}}" bindchange="bindPickerChange" range="{{selectPointList}}" range-key="store_name">
      <view class="search-select">
        <view class="select-text">{{selectPointList[selectPicker].store_name}}</view>
        <view class="point-icon-box">
          <view class="point-icon"></view>
        </view>
      </view>
    </picker>
    <view class="search-button">
      <view class="button month-button {{dateType=='month'?'is-active':'' }}" bindtap="switchRule" data-type="month">月榜</view>
      <view class="button year-button {{dateType=='year'?'is-active':'' }}" bindtap="switchRule" data-type="year">年榜</view>
    </view>
  </view>
  <!-- tab -->
  <view class="tab-box">
    <view  class=" {{item.value == tabValue?'tab-is':''}} tab-item" wx:for="{{tabList}}" wx:key="index" bindtap="switchTab" data-item="{{item}}" >
      {{item.label}}
      <view wx:if="{{item.value == tabValue}}" class="line-box"></view>
    </view>
  </view>
  <view class="info-text-box" wx:if="{{tabValue!==1}}">
    <view  class="info-text">页面数据统计截至时间为{{(tabValue==2 || tabValue==1)?updateDate:updateDate2}}</view>
    <image bindtap="switchSort" class="img" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.1.2/info-icon.png" />
  </view>
  <!-- 明星榜 -->
  <scroll-view  class="content-box" scroll-y="{{true}}" wx:if="{{tabValue==1 && performanceList.active.length !==0 || tabValue==1 && performanceList.customer.length !==0 || tabValue==1&& performanceList.invitation.length !==0}}"> 
    <!-- 邀约榜 -->
    <view class="content-list" wx:if="{{performanceList.invitation.length}}">
      <view class="top-box">
        <view class="top-line"></view>
        <view class="top-text">邀约TOP10</view>
        <view class="top-line"></view>
      </view>
      <view class="info-text-box info-text-box-center">
        <view  class="info-text">页面数据统计截至时间为{{updateDate}}</view>
      </view>
      <view  wx:for="{{performanceList.invitation}}" wx:key="index" class="list-box">
        <view class="list-item">
          <view class="list-l">
            <image class="img" src="{{item.avatar}}"  mode="aspectFill" />
            <view class="icon  {{index+1 == 1 ? 'img-icon1': ''}} {{index+1 == 2 ? 'img-icon2': ''}} {{index+1 == 3 ? 'img-icon3': ''}} "></view>
          </view>
          <view class="list-c">
            <view class="c-img-box">
              <view class="c-img-text">{{item.name}}</view>
              <view class="c-icon {{index+1 == 1 ? 'icon-1': ''}} {{index+1 == 2 ? 'icon-2': ''}} {{index+1 == 3 ? 'icon-3': ''}} ">{{index==0 ?'NO.1':index==1?'NO.2':index==2?'NO.3':''}}</view>
            </view>
            <view class="list-c-c">{{item.store_name}} </view>
          </view>
          <view class="list-r">
          </view>
        </view>
        <view class="info-data pd-invitation">
          <view class="info-box">
            <view class="info-item">
              <view class="info-num">{{ item.num}}</view>
              <view class="info-text">邀约数</view>
            </view>
            <view class="info-item">
              <view class="info-num">{{ item.success_num}}</view>
              <view class="info-text">成功数</view>
            </view>
            <view class="info-item">
              <view class="info-num">{{tools.moneyFormat(item.price_total)}}</view>
              <view class="info-text">成功金额</view>
            </view>
          </view>
        </view>
     </view>
     <view class="more-box" bindtap="setEnable" data-key="invitation"  wx:if="{{performanceList.invitationAll.length>5}}">
      <view class="more-text">{{performanceList.invitationShow?'点击展开':'点击收起'}}</view>
      <view class="triangle-icon {{performanceList.invitationShow?'':'rotate'}}"></view>
     </view>
    </view>
    <!-- 顾客榜 -->
    <view class="content-list"  wx:if="{{performanceList.customer.length}}">
      <view class="top-box">
        <view class="top-line"></view>
        <view class="top-text">顾客榜TOP10</view>
        <view class="top-line"></view>
      </view>
      <view class="info-text-box info-text-box-center">
        <view  class="info-text">页面数据统计截至时间为{{updateDate2}}</view>
      </view>
      <view  wx:for="{{performanceList.customer}}"  wx:key="index" class="list-box">
        <view class="list-item list-t">
          <view class="list-l">
            <image class="img" src="{{item.avatar}}"  mode="aspectFill" />
            <view class="icon {{index + 1 === 1 ? 'img-icon1': ''}} {{index + 1 == 2 ? 'img-icon2': ''}} {{index + 1 == 3 ? 'img-icon3': ''}} "></view>
          </view>
          <view class="list-c">
            <view class="c-img-box">
              <view class="c-img-text">{{item.name}}</view>
              <view class="c-icon {{index+1 == 1 ? 'icon-1': ''}} {{index+1 == 2 ? 'icon-2': ''}} {{index+1 == 3 ? 'icon-3': ''}}">{{index==0 ?'NO.1':index==1?'NO.2':index==2?'NO.3':''}}</view>
            </view>
            <view class="list-c-c">{{item.store_name}} </view>
          </view>
          <view class="list-r">
            <view class="list-r-num">{{item.new_contact_cnt}}</view>
            <view class="list-r-text">新增顾客数</view>
          </view>
        </view>
        <viw class="h-2"></viw>
      </view>
      <view class="more-box" bindtap="setEnable" data-key="customer" wx:if="{{performanceList.customerAll.length>5}}">
        <view class="more-text">{{performanceList.customerShow?'点击展开':'点击收起'}}</view>
        <view class="triangle-icon {{performanceList.customerShow?'':'rotate'}}"></view>
       </view>
    </view>
    <!-- 活跃榜 -->
    <view class="content-list" wx:if="{{performanceList.active.length}}">
      <view class="top-box">
        <view class="top-line"></view>
        <view class="top-text">活跃榜TOP10</view>
        <view class="top-line"></view>
      </view>
      <view class="info-text-box info-text-box-center">
        <view  class="info-text">页面数据统计截至时间为{{updateDate2}}</view>
      </view>
      <view wx:for="{{performanceList.active}}"   wx:key="index" class="list-box" wx:for-index="index">
        <view class="list-item" >
          <view class="list-l">
            <image class="img" src="{{item.avatar}}"  mode="aspectFill" />
            <view class="icon img-icon1"></view>
          </view>
          <view class="list-c">
            <view class="c-img-box">
              <view class="c-img-text">{{item.name}}</view>
              <view class="c-icon {{index+1 == 1 ? 'icon-1': ''}} {{index+1 == 2 ? 'icon-2': ''}} {{index+1 == 3 ? 'icon-3': ''}}">{{index==0 ?'NO.1':index==1?'NO.2':index==2?'NO.3':''}}</view>
            </view>
            <view class="list-c-c">{{item.store_name}} </view>
          </view>
          <view class="list-r">
            <!-- <view class="list-r-num">10</view>
            <view class="list-r-text">新增顾客数</view> -->
          </view>
        </view>
        <view class="info-data pd-active">
          <view class="info-box">
            <view class="info-item">
              <view class="info-num">{{ item.chat_cnt}}</view>
              <view class="info-text">聊天总数</view>
            </view>
            <view class="info-item">
              <view class="info-num">{{ item.message_cnt}}</view>
              <view class="info-text">发消息总数</view>
            </view>
            <view class="info-item">
              <view class="info-num">{{ item.reply_percentage}}%</view>
              <view class="info-text">已回复聊天占比</view>
            </view>
          </view>
        </view>
      </view>
      <view class="more-box" bindtap="setEnable" data-key="active" wx:if="{{performanceList.activeAll.length>5}}">
        <view class="more-text">{{performanceList.activeShow?'点击展开':'点击收起'}}</view>
        <view class="triangle-icon {{performanceList.activeShow?'':'rotate'}}"></view>
       </view>
    </view>
    <view class="h-30"></view>
  </scroll-view>
  <!-- 邀约榜-->
  <scroll-view class="content-box" scroll-y="{{true}}" wx:if="{{tabValue==2&&performanceLists.length}}" bindscrolltolower="handleToViewMore">
    <view class="content-list-tab" >
      <view  wx:for="{{performanceLists}}" wx:for-index="index" wx:key="index" class="list-box list-box-tab">
        <view class="list-item list-item-tab">
          <view class="list-l">
            <image class="img" src="{{item.avatar}}"  mode="aspectFill" />
            <view class="icon  {{index+1 == 1 ? 'img-icon1': ''}} {{index+1 == 2 ? 'img-icon2': ''}} {{index+1 == 3 ? 'img-icon3': ''}} "></view>
          </view>
          <view class="list-c">
            <view class="c-img-box">
              <view class="c-img-text">{{item.name}}</view>
              <view class="c-icon {{index+1 == 1 ? 'icon-1': ''}} {{index+1 == 2 ? 'icon-2': ''}} {{index+1 == 3 ? 'icon-3': ''}} ">{{index==0 ?'NO.1':index==1?'NO.2':index==2?'NO.3':''}}</view>
            </view>
            <view class="list-c-c">{{item.store_name}} </view>
          </view>
          <view class="record-info" wx:if="{{item.is_view == 1}}" data-item="{{item}}" bindtap="goRecordPage">
            查看邀约明细
          </view>
          <view class="list-r" wx:if="{{item.is_view !== 1}}">
          </view>
        </view>
        <view class="info-data pd-invitation">
          <view class="info-box">
            <view class="info-item">
              <view class="info-num">{{ item.num}}</view>
              <view class="info-text">邀约数</view>
            </view>
            <view class="info-item">
              <view class="info-num">{{ item.success_num}}</view>
              <view class="info-text">成功数</view>
            </view>
            <view class="info-item">
              <view class="info-num">{{tools.moneyFormat(item.price_total)}}</view>
              <view class="info-text">成功金额</view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="h-30"></view>
  </scroll-view>
  <!-- 顾客榜-->
  <scroll-view class="content-box" scroll-y="{{true}}" wx:if="{{tabValue==3&&performanceLists.length}}" bindscrolltolower="handleToViewMore">
    <view class="content-list-tab">
      <!-- <view class="top-box">
        <view class="top-line"></view>
        <view class="top-text">顾客榜TOP10</view>
        <view class="top-line"></view>
      </view> -->
      <view  wx:for="{{performanceLists}}" wx:for-index="index" wx:key="index" class="list-box list-box-tab">
        <view class="list-item list-t list-item-tab">
          <view class="list-l">
            <image class="img" src="{{item.avatar}}"  mode="aspectFill" />
            <view class="icon {{index + 1 == 1 ? 'img-icon1': ''}} {{index + 1 == 2 ? 'img-icon2': ''}} {{index + 1 == 3 ? 'img-icon3': ''}} "></view>
          </view>
          <view class="list-c">
            <view class="c-img-box">
              <view class="c-img-text">{{item.name}}</view>
              <view class="c-icon {{index+1 == 1 ? 'icon-1': ''}} {{index+1 == 2 ? 'icon-2': ''}} {{index+1 == 3 ? 'icon-3': ''}}">{{index==0 ?'NO.1':index==1?'NO.2':index==2?'NO.3':''}}</view>
            </view>
            <view class="list-c-c">{{item.store_name}} </view>
          </view>
          <view class="list-r">
            <view class="list-r-num">{{item.new_contact_cnt}}</view>
            <view class="list-r-text">新增顾客数</view>
          </view>
        </view>
        <viw class="h-2"></viw>
      </view>
    </view>
    <view class="h-30"></view>
  </scroll-view>
  <!-- 活跃榜-->
  <scroll-view class="content-box" scroll-y="{{true}}" wx:if="{{tabValue==4&&performanceLists.length}}" bindscrolltolower="handleToViewMore">
    <view class="content-list-tab" >
      <!-- <view class="top-box">
        <view class="top-line"></view>
        <view class="top-text">邀约TOP10</view>
        <view class="top-line"></view>
      </view> -->
      <view wx:for="{{performanceLists}}" wx:for-index="index"  wx:key="index" class="list-box list-box-tab">
        <view class="list-item list-item-tab" >
          <view class="list-l">
            <image class="img" src="{{item.avatar}}"  mode="aspectFill" />
            <view class="icon img-icon1"></view>
          </view>
          <view class="list-c">
            <view class="c-img-box">
              <view class="c-img-text">{{item.name}}</view>
              <view class="c-icon {{index+1 == 1 ? 'icon-1': ''}} {{index+1 == 2 ? 'icon-2': ''}} {{index+1 == 3 ? 'icon-3': ''}}">{{index==0 ?'NO.1':index==1?'NO.2':index==2?'NO.3':''}}</view>
            </view>
            <view class="list-c-c">{{item.store_name}} </view>
          </view>
          <view class="list-r">
            <!-- <view class="list-r-num">10</view>
            <view class="list-r-text">新增顾客数</view> -->
          </view>
        </view>
        <view class="info-data pd-active">
          <view class="info-box">
            <view class="info-item">
              <view class="info-num">{{ item.chat_cnt}}</view>
              <view class="info-text">聊天总数</view>
            </view>
            <view class="info-item">
              <view class="info-num">{{ item.message_cnt}}</view>
              <view class="info-text">发消息总数</view>
            </view>
            <view class="info-item">
              <view class="info-num">{{ item.reply_percentage}}%</view>
              <view class="info-text">已回复聊天占比</view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="h-30"></view>
  </scroll-view>
  <!-- 无数据 -->
  <view class="no-list" wx:if="{{ tabValue!==1&& performanceLists.length==0 || tabValue==1 && performanceList.active.length==0 && performanceList.customer.length==0 && performanceList.invitation.length==0}}">
    <image src="https://cdn-cos.coach.com.cn/uploads/2022/v3.1.2/no-list.png" class="img" />
    <view class="no-list-text">所选时间段暂无榜单数据~</view>
  </view>
  <!-- 提示弹窗 -->
  <view class="info-prop" wx:if="{{isSort}}" bindtap="close">
    <view class="info-box" catchtap="closes">
      <!-- <view class="delete-icon"></view> -->
      <image class="delete-icon" catchtap="close" src="{{closeIcon}}" alt="" />
      <view class="info-text">
        <view class="title-t">{{tabList[tabValue - 1].label}}</view>
        <view class="text-t">{{sortTitle}}</view>
      </view>
    </view>
  </view>
</view>

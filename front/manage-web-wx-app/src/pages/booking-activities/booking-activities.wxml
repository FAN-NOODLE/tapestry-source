<view class="booking-activities">
    <!-- 搜索 -->
    <view class="serach">
        <view class="search-box">
            <input type="text" maxlength="20" value="{{searchValue}}" bindinput="changeInput" bindblur="handleSearch" placeholder="请输入用户名/手机号" placeholder-style="color: rgb(197, 200, 205)" />
         
            <image hidden="{{!searchValue}}" class="search-icon del-icon" bindtap="clearSearch" src="https://cdn-cos.coach.com.cn/uploads/2022/v2.8.0/search_clear.png"  />
        
            <image class="search-icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v2.8.0/search.png" />
        </view>
        <button class="btn" bindtap="goSetupPage" wx:if="{{isAdmin}}">预约配置</button>
    </view>
    <!-- tab 切换 -->
    <view class="tabs">
        <view class="tab-item {{tabCheckedIndex === item.id && 'is-selected'}}" wx:for="{{tabs}}" wx:key="index" data-id="{{item.id}}" bindtap="switchTab">
            {{item.name}}
        </view>
    </view>
    <!-- 客户总数 -->
    <view class="all-people">共{{count}}人</view>
    <!-- 客户列表 -->
    <scroll-view  scroll-y class="{{isIPhoneX ? 'scroll-customer': 'scroll-ios-customer'}}" lower-threshold="10" bindscrolltolower="handleReachBottom">
        <block wx:if="{{!(!pageInfo.loading && customerList.length == 0)}}">
            <!-- 预约客户item -->
            <customer wx:for="{{customerList}}" wx:key="index" info="{{item}}" bind:writeOff="writeOff"></customer>
            <!-- 自定义加载中 -->
            <custom-loading isLoading="{{pageInfo.loading}}" hasMore="{{pageInfo.hasMore}}"></custom-loading>
        </block>
        <!-- 当数据为空时展示 -->
        <mp-empty wx:else icon="store" content="暂无用户信息"></mp-empty>
    </scroll-view>

    <!-- 提示弹窗 -->
    <toast id="toast" />
    
    <!-- 扫码核销 -->
    <view class="scan-code {{isIPhoneX ? 'isIosBottom': ''}}">
        <button bindtap="scanCodeEvent">扫码核销</button>
    </view>
</view>
<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
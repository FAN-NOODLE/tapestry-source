<wxs module="tools">
  /** 
  * 判断底部按钮是否置灰
  * @param delivery_type 1. 自提 2.快递订单
  * @param detail 订单信息
  */
  var isDisabled = function( delivery_type, logistics_name, logistics_no, tickets, delivery_time, sales_order_no){
    // 是否自提
    var condition = delivery_type === 2 ?
     (!logistics_name || !logistics_no || !tickets || !delivery_time || !sales_order_no)
     : 
     (!tickets || !delivery_time || !sales_order_no)
    
    return condition ? 'disabled' : ''
  }
  module.exports = {
    isDisabled : isDisabled
  }
</wxs>
<view class="page-send-goods">
    <view wx:if="{{!isLoading}}">
        <view class="page-send-goods-main">
            <view class="page-send-goods-main-title">发货信息</view>
            <view class="page-send-goods-main-item flex" wx:if="{{delivery_type == 2}}">
                <view class="page-send-goods-main-item-label">快递公司</view>
                <view class="page-send-goods-main-item-value flex">
                    <picker mode="selector" range="{{deliveryCompany}}" range-key="value" value="{{detail.logistics_name}}" bindchange="handleToChooseCompany">
                        <view class="flex" style="align-items: center">
                            <view class="placeholder-color">{{detail.logistics_name || '选择快递公司'}}</view>
                            <image class="icon_right" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.2/weclient/icon_right_black.png" lazy-load="{{true}}" mode="aspectFill" />
                        </view>
                    </picker>
                </view>
            </view>
            <view class="page-send-goods-main-item flex" wx:if="{{delivery_type == 2}}">
                <view class="page-send-goods-main-item-label">快递单号</view>
                <view class="page-send-goods-main-item-value flex">
                    <input value="{{detail.logistics_no}}" bindinput="handleInput" placeholder="输入快递单号" placeholder-class="placeholder-color" />
                    <image class="icon_scan" bind:tap="handleToScan" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.2/weclient/icon_scan.png" lazy-load="{{true}}" mode="aspectFill" />
                </view>
            </view>
            <view class="page-send-goods-main-item flex">
                <view class="page-send-goods-main-item-label">销售单号</view>
                <view class="page-send-goods-main-item-value flex">
                    <view>{{detail.store_name}}-</view>
                    <input value="{{detail.sales_order_no}}" bindinput="handleInputSalesOrderNo" placeholder="输入销售单号" placeholder-class="placeholder-color"></input>
                </view>
            </view>
            <view class="page-send-goods-main-item flex">
                <view class="page-send-goods-main-item-label">录单日期</view>
                <view class="page-send-goods-main-item-value">
                    <picker mode="date" start="{{startTime}}" end="{{endTime}}" value="{{detail.delivery_time}}" bindchange="bindJoinDateChange">
                        <view class="placeholder-color" wx:if="{{!detail.delivery_time}}">选择录单日期</view>
                        <view wx:else>{{detail.delivery_time}}</view>
                    </picker>
                </view>
            </view>
            <view class="page-send-goods-main-item">
                <view class="page-send-goods-main-item-label">拍照上传小票</view>
                <view class="page-send-goods-main-item-value upload-single {{detail.tickets ? '' : 'border'}}" bind:tap="handleUpload">
                    <image class="upload-single-bg" wx:if="{{!detail.tickets}}" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.2/weclient/icon_camera.png" mode="aspectFill" lazy-load="{{true}}" />
                    <view class="upload-img" wx:else>
                        <image src="{{detail.tickets}}" mode="scaleToFill" lazy-load="{{true}}" />
                        <view class="upload-single-repeat">重新上传</view>
                    </view>
                </view>
            </view>
        </view>
        <view class="page-send-goods-operate" >
            <button class="page-send-goods-operate-send flex-center {{tools.isDisabled(delivery_type, detail.logistics_name, detail.logistics_no, detail.tickets, detail.delivery_time, detail.sales_order_no)}}" bind:tap="handleToDelivery">
                {{isEdit ? '确认修改' : '确认发货' }}
            </button>
        </view>
    </view>
</view>

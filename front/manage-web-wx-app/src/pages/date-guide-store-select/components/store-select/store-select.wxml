<!-- 门店筛选模块 -->
<view class="store-box">
  <view class="top-fixed-box">
    <!-- 搜索模块 -->
    <view class="search-bar">
      <image class="icon-search" src="https://cdn-cos.coach.com.cn/uploads/2024/v4.1.3/icon_search.png" />
      <view class="input-box">
        <input class="code-ipt" placeholder-class="input-placeholder" value="{{ keywords }}" focus="{{false}}" placeholder="{{placeholder}}" maxlength="15" bindinput="searchStaff" />
        <view class="search-cacel" wx:if="{{keywords}}" catchtap="clearValue">
          <image class="cacel-icon" src="https://cdn-cos.coach.com.cn/uploads/2024/v4.2.0/icon_clear.png" />
        </view>
      </view>
    </view>
    <!-- 选择门店多选提示 -->
    <view class="choose-store-tip" wx:if="{{currentList.length > 0}}">{{mautiple?'可多选':'单选'}}</view>
  </view>
  <!-- 门店列表展示模块 -->
  <view class="store-list-box">
    <!-- 列表循环 -->
    <view class="p-l-15 p-r-15 bg-white" wx:if="{{ready && currentList.length > 0}}">
      <view class="item-list font-sc-me {{item.is_check ? 'select-item':''}}" wx:for="{{currentList}}" wx:key="index" data-item="{{item}}" data-index="{{index}}" bindtap="chooseItem">
        <view>
          <text>{{item.short_name || item.name || item.counter_name}}</text>
        </view>
        <view class="select-img-box" wx:if="{{item.is_check}}">
          <image class="select-img" src="https://img-crs.vchangyi.com/store-manage-wxapp/guide_check_select.png" />
        </view>
      </view>
    </view>
    <!-- 空组件 -->
    <mp-empty wx:if="{{currentList.length == 0 && keywords}}" slogan="暂无搜索结果" icon="order" />
    <mp-empty wx:if="{{ready && currentList.length == 0 && !keywords}}" slogan="{{defultText}}" icon="order" />
    <!-- 门店选择确认按钮 -->
    <view class="store-btn-box {{isIpx ? 'ipx-btn-box' : ''}}">
      <view class="cacel-btn" bindtap="reset">重置</view>
      <view class="sure-btn" bindtap="confirmTap" wx:if="{{range == 2}}">
        {{chooseList.length > 0 && mautiple ? '选择'+ chooseList.length +'家门店' : chooseList.length > 0 && !mautiple ? '选择' :'选择全部门店'}}
      </view>
      <view class="sure-btn" bindtap="confirmTap" wx:if="{{range == 3}}">
        {{chooseList.length > 0 && mautiple ? '选择'+ chooseList.length +'个部门' :  chooseList.length > 0 && !mautiple ? '选择' : '选择全部部门'}}
      </view>
    </view>
  </view>
</view>
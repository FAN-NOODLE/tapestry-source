<!-- 导购筛选模块 -->
<view class="guide-box">
  <view class="top-fixed-box">
    <!-- 搜索模块 -->
    <view class="search-bar">
      <image class="icon-search" src="https://cdn-cos.coach.com.cn/uploads/2024/v4.1.3/icon_search.png" />
      <view class="input-box">
        <input class="code-ipt" placeholder-class="input-placeholder" value="{{ keywords }}" focus="{{false}}" placeholder="搜索导购姓名、手机号" maxlength="15" bindinput="searchStaff" />
        <view class="search-cacel" wx:if="{{keywords}}" catchtap="clearValue">
          <image class="cacel-icon" src="https://cdn-cos.coach.com.cn/uploads/2024/v4.2.0/icon_clear.png" />
        </view>
      </view>
    </view>
    <!-- 选择全部导购按钮 -->
    <view class="all-guide-box" bindtap="chooseAll" wx:if="{{!keywords && mautiple}}">
      <image class="pre-check" wx:if="{{isAll}}" src="~@/images/customer/select-check.png" />
      <image class="pre-check" wx:else src="~@/images/customer/no-check.png" />
      <view class="all-guide">全部导购</view>
    </view>
  </view>
  <view class="guide-list-box" wx:if="{{ready && list.length > 0}}">
    <view wx:if="{{item.is_show}}" class="item-list {{item.is_check ? '' : 'no-checked'}}" wx:for="{{list}}" wx:key="index">
      <view class="item-top" bindtap="showGuideList" data-index="{{index}}" data-item="{{item}}">
        <view class="left">
          <image class="icon" src="~@/images/coach/updown.png" />
          <view class="{{item.is_check ? 'checked' : ''}}">{{item.store_name}}</view>
        </view>
        <view wx:if="{{!keywords && mautiple}}" class="right" catchtap="chooseItem" data-item="{{item}}" data-index="{{index}}" >
          <image class="pre-check" wx:if="{{item.is_check}}" src="~@/images/customer/select-check.png" />
          <image class="pre-check" wx:else src="~@/images/customer/no-check.png" />
        </view>
      </view>
      <view wx:if="{{item.show_all}}">
        <view wx:if="{{cell.is_show}}" class="child-item" wx:for="{{item.guide_list}}" wx:for-item="cell"  wx:for-index="ind" wx:key="ind">
          <view class="left">
            <view class="{{cell.is_check ? 'checked' : ''}}">{{cell.name}}</view>
            <view class="{{cell.is_check ? 'checked' : ''}}">（{{cell.mobile}}）</view>
            <view wx:if="{{role === 3 && !isBa}}" class="type-box {{item.type == 1 ? 'type1': ''}} {{item.type == 2 ? 'type2': ''}} {{item.type == 3 ? 'type3': ''}} {{item.type == 4 ? 'type4': ''}}">
              {{cell.typeName}}
            </view>
            <view wx:if="{{!isBa}}" class="tag {{cell.worker_status===1?'on-duty':'leaving'}}">
              {{cell.worker_status===1?'在岗':'离岗'}}
            </view>
          </view>
          <view class="right" bindtap="chooseCell" data-ind="{{ind}}" data-index="{{index}}" >
            <image class="pre-check" wx:if="{{cell.is_check}}" src="~@/images/customer/select-check.png" />
            <image class="pre-check" wx:else src="~@/images/customer/no-check.png" />
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{!ready}}">
    <image class="empty-icon" src="https://cdn-cos.coach.com.cn/uploads/common/loading-1.gif"/>
  </view>
  <view class="h-150"></view>
  <!-- 空组件 -->
  <mp-empty wx:if="{{list.length == 0 && keywords}}" slogan="暂无搜索结果" icon="order" />
  <mp-empty wx:if="{{ready && list.length == 0 && !keywords}}" slogan="暂无导购" icon="order" />
  <!-- 门店选择确认按钮 -->
  <view class="store-btn-box {{isIpx ? 'ipx-btn-box' : ''}}">
    <view class="cacel-btn" bindtap="reset">重置</view>
    <view class="sure-btn" bindtap="confirmTap">确认</view>
  </view>
</view>
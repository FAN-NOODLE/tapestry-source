<!-- 时间筛选模块 -->
<view class="date-box">
  <view wx:if="{{showDate}}">
    <view class="start-date {{currentClickTime == 1 ? 'current-click-time' : ''}}" bindtap="changeTimeClick" data-type="1">
      {{startTimeText ? startTimeText : '开始日期'}}
    </view>
    <view class="date-cut">—</view>
    <view class="end-date {{currentClickTime == 2 ? 'current-click-time' : ''}}" bindtap="changeTimeClick" data-type="2">
      {{endTimeText ? endTimeText : '结束日期'}}
    </view>
  </view>
  <view wx:else>
    <view class="start-date all-date {{currentClickTime == 1 ? 'current-click-time' : ''}}" bindtap="changeTimeClick" data-type="1">
      {{startTimeText ? startTimeText : '选择时间'}}
    </view>
  </view>
  <view class="picker-box" wx:if="{{showPicker}}">
    <picker-view indicator-style="height: 45px;" style="width: 100%; height: 340px;" value="{{pickerValue}}" bindchange="changeValue">
      <picker-view-column>
        <view wx:for="{{years}}" wx:for-index="yearsIndex" wx:key="yearsIndex" class="{{pickerValue[0] == yearsIndex ? 'current-picker':''}} {{pickerValue[0] == yearsIndex - 1 || pickerValue[0] == yearsIndex + 1 ? 'current-picker-first':''}} {{pickerValue[0] == yearsIndex - 2 || pickerValue[0] == yearsIndex + 2 ? 'current-picker-second':''}} {{pickerValue[0] == yearsIndex - 3 || pickerValue[0] == yearsIndex + 3 ? 'current-picker-third':''}}" style="height: 45px; line-height: 45px; text-align: center;">
          {{item}}年
        </view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{months}}" wx:for-index="monthsIndex" wx:key="monthsIndex" class="{{pickerValue[1] == monthsIndex ? 'current-picker':''}} {{pickerValue[1] == monthsIndex - 1 || pickerValue[1] == monthsIndex + 1 ? 'current-picker-first':''}} {{pickerValue[1] == monthsIndex - 2 || pickerValue[1] == monthsIndex + 2 ? 'current-picker-second':''}} {{pickerValue[1] == monthsIndex - 3 || pickerValue[1] == monthsIndex + 3 ? 'current-picker-third':''}}" style="height: 45px; line-height: 45px; text-align: center; overflow: hidden;">
          <view wx:if="{{displayMonths[0]<=monthsIndex && displayMonths[1]>=monthsIndex}}">
            {{item}}月
          </view>
        </view>
      </picker-view-column>
      <picker-view-column wx:if="{{showDate}}">
        <view wx:for="{{days}}" wx:for-index="daysIndex" wx:key="daysIndex" class="{{pickerValue[2] == daysIndex ? 'current-picker':''}} {{pickerValue[2] == daysIndex - 1 || pickerValue[2] == daysIndex + 1 ? 'current-picker-first':''}} {{pickerValue[2] == daysIndex - 2 || pickerValue[2] == daysIndex + 2 ? 'current-picker-second':''}} {{pickerValue[2] == daysIndex - 3 || pickerValue[2] == daysIndex + 3 ? 'current-picker-third':''}}" style="height: 45px; line-height: 45px; text-align: center; overflow: hidden;">
          <view wx:if="{{displayDays[0]<=daysIndex &&  displayDays[1]>=daysIndex}}">{{item}}日</view>
        </view>
      </picker-view-column>
    </picker-view>
  </view>
  <!-- 门店选择确认按钮 -->
  <view class="date-btn-box {{isIpx ? 'ipx-btn-box' : ''}}">
    <view class="cacel-btn" bindtap="reset">重置</view>
    <view class="sure-btn" bindtap="sure">确认</view>
  </view>
</view>
<view class="page-date-guide-store-select">
  <!-- 门店列表展示模块 -->
  <store-select wx:if="{{currentSelectType.type == 1}}" hasIds="{{hasIds}}" mautiple="{{mautiple}}"></store-select>
  <store-select-new wx:if="{{currentSelectType.type == 4}}" hasIds="{{hasIds}}" mautiple="{{mautiple}}"></store-select-new>
  <!-- 导购列表展示模块 -->
  <guide-select wx:if="{{currentSelectType.type == 2}}" storeIds="{{storeIds}}" isBa="{{isBa}}" dpIds="{{dpIds}}" hasChooseGuideIds="{{hasChooseGuideIds}}" mautiple="{{mautiple}}" role="{{role}}"></guide-select>
  <!-- 时间筛选模块 -->
  <date-select wx:if="{{currentSelectType.type == 3}}" startTime="{{startTime}}" endTime="{{endTime}}" showDate="{{showDate}}" selectDateText="{{selectDateText}}" min="{{min}}" max="{{max}}"></date-select>
  <!-- 新的层级门店列表选择 -->
  <new-store-select wx:if="{{currentSelectType.type == 5}}" hasIds="{{hasIds}}"></new-store-select>
</view>

<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
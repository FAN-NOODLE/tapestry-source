<view class="page-load">
  <view class="" wx:if="{{!confirmModelShow&&!ispartner}}">
    <image class="img" src="https://crs-prod-1251064102.cos.ap-shanghai.myqcloud.com/tapestry-wxapp/wxwork-login-noauth.png" mode="widthFix" lazy-load="false"></image>
    <view class="font-16 p-l-20 p-r-20 color-store font-sc-me main-text m-t-10">未能找到您所在的导购组织</view>
    <view class="color-96979E sce-text font-12 p-l-20 p-r-20 m-t-13 font-sc-re">
      请向企业管理员申请加入导购组织后重新进入应用～
    </view>
  </view>
  <!-- 提示弹框 -->
  <message-modal
    ispartner="{{ispartner}}"
    show="{{ confirmModelShow }}"
    isSingle="{{isSingle}}"
    isAuthent="{{isAuthent}}"
    description="{{dialogText}}"
    descriptionTwo="{{dialogTwoText}}"
    sureText="{{sureText}}"
    catchtouchmove="stopPageScroll"
    bindclose="closeConfirmModel"
    bindcancel="closeConfirmModel"
    bindsure="onModelConfirm"
  ></message-modal>
</view>


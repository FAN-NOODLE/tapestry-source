<view class="order-list">
  <block wx:if="{{orderList.length > 0}}">
    <view wx:for="{{orderList}}" wx:key="id" class="order-item">
      <view class="list-title">
        <view>下单时间：</view>
        <view class="time">{{item.purchase_date}}</view>
      </view>
      <view class="list-line"></view>
      <view
        class="list-goods"
        wx:for="{{item.purchase_skus}}"
        wx:for-item="itm"
        wx:key="id"
      >
        <view class="sku-name">{{itm.sku_name}}</view>
        <view class="number">x {{itm.quantity}}</view>
      </view>
      <view class="list-info">
        <view>订单编号：{{item.order_no}}</view>
        <view>订单金额：￥{{item.amount}}</view>
        <view>来源：{{item.store_name}}</view>
      </view>
    </view>
  </block>
  <mp-empty wx:else slogan="暂无订单" icon="customer" />
  <view class="bottom-tip" wx:if="{{orderList.length > 0 && !meta.isMore }}">已经到底了~</view>
  <view wx:if="{{isLoading && meta.page !== 1}}" class="loading-box">加载中～</view>
</view>

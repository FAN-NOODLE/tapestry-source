<wxs module="tool">
  module.exports.adjustNum = function(num) {
  var adjust = 0
  if (num) {
  adjust = (num*100).toFixed(2)
  }
  return adjust;
  }
</wxs>
<view class="page-ranking-list">
  <view class="top-fixed-box">
    <!-- 顶部tab -->
    <view class="tab-wrap font-sc-se font-16 p-l-15">顾客数据</view>
    <!-- 顾客数据的tab -->
    <view class="content" wx:if="{{currentTab == 1}}">
      <view class="sencond-tab-box-content flex-s-c">
        <view
          class="sencond-tab-item {{item.id === currentCustomerTab ? 'current-sencond-tab':''}}"
          wx:for="{{customerTabs}}"
          wx:key="index"
          bindtap="changeCustomerTab"
          data-item="{{ item }}"
        >{{item.text}}</view>
      </view>
    </view>
  </view>
  <view class="placehoder-bg"></view>
  <!-- 时间筛选加列表展示模块 -->
  <view class="list-date-box">
    <!-- 时间筛选模块(顾客总数两个标签下无时间筛选) -->
    <view class="date-box" wx:if="{{!(currentTab == 1 && (currentCustomerTab == 1 || currentCustomerTab == 7))}}">
      <view>
        <view
          class="item-date {{currentDate == 4 ? 'current-date':''}}"
          bindtap="selectDate"
          data-type="4"
        >昨天</view>
        <view
          class="item-date {{currentDate == 5 ? 'current-date':''}}"
          bindtap="selectDate"
          data-type="5"
        >今天</view>
        <view
          class="item-date {{currentDate == 1 ? 'current-date':''}}"
          bindtap="selectDate"
          data-type="1"
        >近7天</view>
        <view
          class="item-date {{currentDate == 2 ? 'current-date':''}}"
          bindtap="selectDate"
          data-type="2"
        >近30天</view>
      </view>
      <view class="custom-date" bindtap="selectDate" data-type="3">
        <view class="{{currentDate == 3 && startTimeText ? 'self':''}}">自定义</view>
        <image
          wx:if="{{currentDate == 3 && startTimeText}}" 
          class="arrow-bottom"
          src="https://img-crs.vchangyi.com/store-manage-wxapp/grey_arrow.png"
        />
        <image
          wx:else
          class="arrow-bottom"
          src="https://img-crs.vchangyi.com/store-manage-wxapp/grey_arrow.png"
        />
      </view>
      <view wx:if="{{currentDate == 3 && startTimeText}}" class="definition-time">
        {{startTimeText + '-' + endTimeText}}
      </view>
      <view wx:if="{{currentCustomerTab === 8}}" class="right-box tab-list">
        <view class="num">邀约数</view>
        <view class="num">成功数</view>
        <view class="num price">成功金额</view>
      </view>
    </view>
    <!-- 顾客数据列表 -->
    <view class="list-box" wx:if="{{currentTab == 1 && currentCustomerTab !== 8}}">
      <block wx:if="{{ready && customerList.length > 0}}">
        <view class="item-list" wx:for="{{customerList}}" wx:key="index">
          <view class="flex">
            <view class="item-sort">
              <image
                class="sort-img"
                wx:if="{{index == 0}}"
                src="https://img-crs.vchangyi.com/store-manage-wxapp/rank_top_01.png"
              />
              <image
                class="sort-img"
                wx:if="{{index == 1}}"
                src="https://img-crs.vchangyi.com/store-manage-wxapp/rank_top_02.png"
              />
              <image
                class="sort-img"
                wx:if="{{index == 2}}"
                src="https://img-crs.vchangyi.com/store-manage-wxapp/rank_top_03.png"
              />
              <view class="font-sc-re" wx:if="{{index > 2}}">{{index < 9 ? '0'+(index+1) : index+1}}</view>
            </view>
            <view class="item-avatar">
              <image src="{{item.avatar}}" />
            </view>
            <view class="item-msg">
              <view class="item-name">{{item.shopping_guide_name}}</view>
              <view class="item-department">{{item.belonging_store}}</view>
            </view>
          </view>
          <view class="item-num" wx:if="{{currentCustomerTab===5}}">{{item.num}}个</view>
          <view class="item-num" wx:elif="{{currentCustomerTab===6}}">{{tool.adjustNum(item.num) + '%'}}</view>
          <view class="item-num" wx:else>{{item.num}}人</view>
        </view>
        <view class="bottom-tip"> {{customerList.length < 50 ? "已经到底了" : "只展示前50名导购"}}</view>
      </block>
      <mp-empty wx:if="{{ready && customerList.length == 0}}" slogan="当前暂无排行～" icon="order"></mp-empty>
    </view>
    <!-- 分销数据列表 -->
    <view class="list-box" wx:if="{{currentTab == 2 && currentCustomerTab !== 8}}">
      <block wx:if="{{ready && distributionList.length > 0}}">
        <view class="item-list" wx:for="{{distributionList}}" wx:key="index">
          <view class="flex">
            <view class="item-sort">
              <image
                class="sort-img"
                wx:if="{{index == 0}}"
                src="https://img-crs.vchangyi.com/store-manage-wxapp/rank_top_01.png"
              />
              <image
                class="sort-img"
                wx:if="{{index == 1}}"
                src="https://img-crs.vchangyi.com/store-manage-wxapp/rank_top_02.png"
              />
              <image
                class="sort-img"
                wx:if="{{index == 2}}"
                src="https://img-crs.vchangyi.com/store-manage-wxapp/rank_top_03.png"
              />
              <view class="font-sc-re" wx:if="{{index > 2}}">{{index < 9 ? '0'+(index+1) : index+1}}</view>
            </view>
            <view class="item-avatar">
              <image src="{{item.avatar}}" />
            </view>
            <view class="item-msg">
              <view class="item-name">{{item.name}}</view>
              <view class="item-department">{{item.store_name}}</view>
            </view>
          </view>
          <view
            class="item-num"
            wx:if="{{currentDistributionTab == 1}}"
          >￥{{item.settlement_money / 100}}</view>
          <view class="item-num" wx:if="{{currentDistributionTab == 2}}">{{item.settlement_num}}笔</view>
        </view>
        <view class="bottom-tip">{{distributionList.length < 50 ? "已经到底了" : "只展示前50名导购"}}</view>
      </block>
      <mp-empty wx:if="{{ready && distributionList.length == 0}}" slogan="当前暂无排行～" icon="order"></mp-empty>
    </view>
    <!-- 订单数据列表 -->
    <view class="list-box" wx:if="{{currentTab == 3 && currentCustomerTab !== 8}}">
      <block wx:if="{{ready && orderList.length > 0}}">
        <view class="item-list" wx:for="{{orderList}}" wx:key="index">
          <view class="flex">
            <view class="item-sort">
              <image
                class="sort-img"
                wx:if="{{index == 0}}"
                src="https://img-crs.vchangyi.com/store-manage-wxapp/rank_top_01.png"
              />
              <image
                class="sort-img"
                wx:if="{{index == 1}}"
                src="https://img-crs.vchangyi.com/store-manage-wxapp/rank_top_02.png"
              />
              <image
                class="sort-img"
                wx:if="{{index == 2}}"
                src="https://img-crs.vchangyi.com/store-manage-wxapp/rank_top_03.png"
              />
              <view class="font-sc-re" wx:if="{{index > 2}}">{{index < 9 ? '0'+(index+1) : index+1}}</view>
            </view>
            <view class="item-avatar">
              <image src="{{item.avatar}}" />
            </view>
            <view class="item-msg">
              <view class="item-name">{{item.name}}</view>
              <view class="item-department">{{item.store_name}}</view>
            </view>
          </view>
          <view
            class="item-num"
            wx:if="{{currentOrderTab == 1 || currentOrderTab == 3}}"
          >{{item.num}}单</view>
          <view
            class="item-num"
            wx:if="{{currentOrderTab == 2 || currentOrderTab == 4}}"
          >￥{{item.num / 100}}</view>
        </view>
        <view class="bottom-tip">{{orderList.length < 50 ? "已经到底了" : "只展示前50名导购"}}</view>
      </block>
      <mp-empty wx:if="{{ready && orderList.length == 0}}" slogan="当前暂无排行～" icon="order"></mp-empty>
    </view>
    <!-- 预约列表 -->
    <view class="list-box" wx:if="{{currentCustomerTab === 8}}">
      <block wx:if="{{ready && rankList.length > 0}}">
        <view class="item-list" wx:for="{{rankList}}" wx:key="index">
          <view class="flex">
            <view class="item-sort">
              <image
                class="sort-img"
                wx:if="{{index == 0}}"
                src="https://img-crs.vchangyi.com/store-manage-wxapp/rank_top_01.png"
              />
              <image
                class="sort-img"
                wx:if="{{index == 1}}"
                src="https://img-crs.vchangyi.com/store-manage-wxapp/rank_top_02.png"
              />
              <image
                class="sort-img"
                wx:if="{{index == 2}}"
                src="https://img-crs.vchangyi.com/store-manage-wxapp/rank_top_03.png"
              />
              <view class="font-sc-re" wx:if="{{index > 2}}">{{index < 9 ? '0'+(index+1) : index+1}}</view>
            </view>
            <view class="item-avatar">
              <image src="{{item.avatar}}" />
            </view>
            <view class="item-msg">
              <view class="item-name ellipses">{{item.member_name}}</view>
              <view class="item-department ellipses">{{item.department_name}}</view>
            </view>
          </view>
          <view class="right-box">
            <view class="num">{{item.num}}</view>
            <view class="num">{{item.success_num}}</view>
            <view class="num price">￥{{item.price}}</view>
          </view>
        </view>
        <view class="bottom-tip"> {{customerList.length < 50 ? "已经到底了" : "只展示前50名导购"}}</view>
      </block>
      <mp-empty wx:if="{{ready && rankList.length == 0}}" slogan="当前暂无排行～" icon="order"></mp-empty>
    </view>
  </view>
  <view class="bottom-btn" bindtap="goCompass">查看数据概览</view>
</view>

<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
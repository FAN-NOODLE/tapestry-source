<view class="page-register" >
	<!-- 背景元素 -->
	<image class="element1" src="https://img-crs.vchangyi.com/store-manage-wxapp/sy_register_ele1.png" mode="aspectFill" lazy-load="true"></image>
	<image class="element2" src="https://img-crs.vchangyi.com/store-manage-wxapp/sy_register_ele2.png" mode="aspectFill" lazy-load="true"></image>
	<image class="element3" src="https://img-crs.vchangyi.com/store-manage-wxapp/sy_register_ele3.png" mode="aspectFill" lazy-load="true"></image>
	<view class="element4">
		<view>
			我是{{worker.enterprise_name||''}}{{worker.name}}
		</view>
		<view class="font">
			邀请您成为我的品牌合伙人，一起赚钱到手软快去注册吧
		</view>
	</view>
	<image class="element5" src="{{worker.avatar}}" mode="aspectFill" lazy-load="true"></image>

	<!-- 合伙人信息 -->
	<view class="info-box">
		<view class="title">填写合伙人信息</view>
		<view class="item avatar"><view class="left">头像</view>
			<image class="right" wx:if="{{partner_info.avatar}}" bindtap="chooseImageTap" src="{{partner_info.avatar}}" mode="aspectFill" lazy-load="false" />
			<image class="right" wx:else bindtap="chooseImageTap" src="{{defaultAvatar}}" mode="aspectFill" lazy-load="false" />
		</view>
		<view class="item">
			<view class="left">称呼</view>
			<view class="right">
				<input type="text" maxlength="10" bindinput="getPartnerName" value="{{partner_info.partner_name}}"  placeholder="请输入您的称呼" disabled="{{status === 2}}"  placeholder-style="color: #C8C8C8;"/>
				<button class="btn" open-type="getUserInfo" bindgetuserinfo="getUserInfo" size="mini"   wx:if="{{status === 1}}">
					授权微信昵称
				</button>
			</view>
		</view>
		<view class="item">
			<view class="left">手机号</view>
			<view class="right">
				<input type="text" value="{{phone.value}}" bindinput="inputGetPhone" disabled="{{status === 2}}" placeholder="请输入您的手机号" maxlength="11" placeholder-style="color: #C8C8C8;"/>
				<button class="btn" open-type="getPhoneNumber" bindgetphonenumber="bindGetPhoneNumber" size="mini"  wx:if="{{status === 1}}" >
					使用微信手机号
				</button>
			</view>
			<text class="error-text" wx:if="{{phone.error && phone.msg}}">{{phone.msg}}</text>
		</view>
		<view class="item">
			<view class="left">手机号展示给导购</view>
			<switch class="right" color="#58BD6B" checked="{{switchChecked}}" bindchange="switchChange"/>
		</view>
		<view class="item" wx:if="{{status === 1}}">
			<view class="left">验证码   <text class="error-text" wx:if="{{code.error && code.msg}}">{{code.msg}}</text></view>
			<view class="right">
				<input type="number" maxlength="4" bindinput="getInputCode" value="{{code.value}}" placeholder="请输入4位验证码"  placeholder-style="color: #C8C8C8;"/>
				<button class="btn color {{!code.click ?'':'checked'}}" bindtap="getCode" open-type="text"  size="mini" >
					{{ !code.click ? '获取验证码' : ('重新获取' + code.ms + 's')}}
				</button>
			</view>	
			<text class="error-text" wx:if="{{code.error && code.msg}}">{{code.msg}}</text>	
		</view>

		<view class="item invite">
			<view class="left">邀请人</view>
			<view class="right">
				<image class="img" src="{{worker.avatar}}" mode="aspectFill" lazy-load="true" bindload=""></image>
				<text>{{worker.name}}</text>
			</view>
		</view>

		<view class="register-btn" bindtap="sendRegister">{{status===2?'一键注册':'注册'}}</view>
	</view>
		
</view>

<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
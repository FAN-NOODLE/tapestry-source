<view class="page-confirm">
  <view class="content">
    <image wx:if="{{selectServer.reserve_img}}" class="top-img" src="{{selectServer.reserve_img}}" />
    <view class="form-item flex-start-center has-line">
      <view class="label flex-start-center">
        <image class="icon" src="../../../images/invite-store/icon-01.png" />
        <view>顾客姓名</view>
      </view>
      <view class="value font-500">{{orderInfo.user_name}}</view>
    </view>
    <view class="form-item flex-start-center has-line">
      <view class="label flex-start-center">
        <image class="icon" src="../../../images/invite-store/icon-02.png" />
        <view>预约服务</view>
      </view>
      <view class="value">
        <view class="font-500">{{orderInfo.serve_name || ""}}</view>
      </view>
    </view>
    <view class="form-item flex-start-center has-line" bindtap="chooseTime">
      <view class="label flex-start-center">
        <image class="icon" src="../../../images/invite-store/icon-03.png" />
        <view>到店时间</view>
      </view>
      <!-- <view class="value">
        <view class="font-500" wx:if="{{selectTime.select_name}}">{{selectTime.select_name}} {{selectTime.name}}</view>
        <view class="placeholder" wx:else>选择到店时间</view>
        <image wx:if="{{orderInfo.is_commit === 0 && orderInfo.status !== 3 && false}}" class="right-icon" src="../../../images/invite-store/right-icon.png" />
      </view> -->
      <view class="value">
        <view class="font-500">{{selectTime.select_name}} {{selectTime.name}}</view>
      </view>
    </view>
    <view class="form-item flex-start-center has-line">
      <view class="label flex-start-center">
        <image class="icon" src="../../../images/invite-store/icon-05.png" />
        <view>服务时长</view>
      </view>
      <view class="value font-500">{{orderInfo.serve_time}}小时</view>
    </view>
    <view class="form-item flex-start-center has-line">
      <view class="label flex-start-center">
        <image class="icon" src="../../../images/invite-store/icon-09.png" />
        <view>预约门店</view>
      </view>
      <view class="value font-500">{{orderInfo.store_name}}</view>
    </view>
    <view class="form-item flex-start-center has-line">
      <view class="label flex-start-center">
        <image class="icon" src="../../../images/invite-store/icon-06.png" />
        <view>门店地址</view>
      </view>
      <view class="value font-500">{{orderInfo.store_address}}</view>
    </view>
    <view class="form-item flex-start-center has-line" wx:if="{{orderInfo.reserve_remark}}">
      <view class="label flex-start-center">
        <image class="icon" src="../../../images/invite-store/icon-07.png" />
        <view>温馨提示</view>
      </view>
      <view class="value font-500">{{orderInfo.reserve_remark}}</view>
    </view>
    <view class="textarea-box" wx:if="{{orderInfo.is_commit === 0 && orderInfo.status !== 3 && orderInfo.status !== 4}}">
      <textarea style="height: 100%" value="{{userRemark}}" maxlength="50" data-key="userRemark" bindinput="changeInput" class="textarea" placeholder="请告知我们你的需要如：准备下午茶" placeholder-class="placeholder-textarea" />
    </view>
    <view class="form-item flex-start-center has-line" wx:else>
      <view class="label flex-start-center">
        <image class="icon" src="../../../images/invite-store/icon-10.png" />
        <view>备注信息</view>
      </view>
      <view class="value font-500">{{userRemark}}</view>
    </view>
    <view class="btn-wrapper" wx:if="{{orderInfo.is_commit === 0 && orderInfo.status !== 3 && orderInfo.status !== 4}}">
      <view wx:if="{{false}}" class="btn gray" bindtap="cancelOrder">取消预约</view>
      <view class="btn active {{isCheck ? '' : 'opcity-60'}}" bindtap="confirmData">确认</view>
    </view>
  </view>
  <show-modal show="{{showModel}}" title="{{modelTitle}}" description="{{description}}" descriptionTwo="{{descriptionTwo}}" bindclose="confirmModel" bindsure="confirmModel" isSingle="{{isSingle}}"></show-modal>
  <invite-date wx:if="{{showTime && dateModel}}" timeObj="{{timeObj}}" bindsumbit="sumbit" bindclose="closeModel"></invite-date>
</view>
<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
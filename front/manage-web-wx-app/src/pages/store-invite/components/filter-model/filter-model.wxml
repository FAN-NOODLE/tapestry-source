<half-screen-dialog show="{{true}}"  wx:if="{{show}}" custom-dialog="filter-selection" custom-mask="custom-mask">
    <view slot="body">
        <!-- body体 -->
        <view class="body">
            <block wx:for="{{options}}" wx:key="key">
                <view class="title">{{item.title}}</view>
                <view class="tag">
                    <view 
                        class="tag-item {{checkedObject[item.key] === optionItem.id ? 'checked' : ''}}"
                        data-key="{{item.key}}"
                        data-id="{{optionItem.id}}"
                        bindtap="clickTag"
                        wx:for="{{item.list}}" 
                        wx:for-item="optionItem" 
                        wx:key="id">
                        {{optionItem.status_name}}

                    </view>
                </view>
            </block>
        </view>

        <!-- 底部按钮 -->
        <view class="btn-group">
          <view class="reset-btn" bindtap="resetData">重置</view>
          <view class="confirm-btn" bindtap="confirm">筛选</view>
        </view> 
    </view>
</half-screen-dialog>
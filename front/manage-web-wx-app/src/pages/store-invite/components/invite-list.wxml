<wxs module="tools">
/* 价格格式化 */
function moneyString(str) {
  str = str.toString()
  if (!str) return //判空

  //切割数组
  //以.分隔为数组
  var arr = str.split('.');

  var left = arr[0];
  var right = arr.length > 1 ? '.' + arr[1] : ''
  //取第一项用正则判断，每隔3位加，
  left = left.replace(getRegExp('\B(?=(\d{3})+$)', 'g'), ',')
  return left + right;
}

function formatMoney(money) {
    if (money) {
        return '¥' + moneyString(money / 100)
    }
    return '--'

}
module.exports = {
  formatMoney: formatMoney
}
</wxs>

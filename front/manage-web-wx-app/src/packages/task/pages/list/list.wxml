<view class="container">
  <view class="header">
    <view class="tabs-item" bind:tap="handleSelectType">
      <view>{{searchParams.task_category>-1 ? typePickerOptions[searchParams.task_category+1].label:'任务类型'}}</view>
    </view>
    <view class="tabs-item" bind:tap="handleSelectStatus">
      <view>{{searchParams.status>-1 ? statusPickerOptions[searchParams.status+1].label:'任务状态'}}</view>
    </view>
  </view>
  <view class="content">
    <view wx:if="{{list.length > 0}}" class="list">
      <task-item wx:for="{{list}}" wx:key="index" item="{{item}}"></task-item>
      <!-- 加载更多 -->
      <mp-load-more custom-class="mp-load-more" status="{{meta.status}}"></mp-load-more>
    </view>
    <!-- 空组件 -->
    <mp-empty wx:if="{{ list.length === 0 && meta.status !== 'loading'}}" margin-top="100" icon="no-task" content="暂无任务信息"/>
  
  </view>
</view>
<!-- 弹窗选择器 - 选择任务类型 -->
<mp-picker show="{{showTypePicker}}" current="{{searchParams.task_category+1}}" options="{{typePickerOptions}}" bind:cancel="handleCancel" bind:confirm="handleSelectTypeConfirm"></mp-picker>
<!-- 弹窗选择器 - 选择任务状态 -->
<mp-picker show="{{showStatusPicker}}" current="{{searchParams.status+1}}" options="{{statusPickerOptions}}" bind:cancel="handleCancel" bind:confirm="handleSelectStatusConfirm"></mp-picker>

<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
<view class="page-record-list">
	<view class="empty" wx:if="{{pageLoading}}">
		<image class="empty-icon" src="https://cdn-cos.coach.com.cn/uploads/common/loading-1.gif" />
	</view>

	<block wx:else>
		<view class="top-select">
			<view class="select-item width-90">
				<view class="time-style">{{selectDate || '时间'}}</view>
				<image class="up-down" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/updown.png" />
				<picker
				 data-key="selectDate"
				 class="picker-box"
				 mode="date"
				 value="{{selectDate}}"
				 bindchange="changeKey"
				>
					<view class="picker">当前选择</view>
				</picker>
			</view>

			<view class="select-item">
				<view>{{statusIndex > - 1 ? statusList[statusIndex].status_name : '状态'}}</view>
				<image class="up-down" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/updown.png" />
				<picker
				 data-key="statusIndex"
				 class="picker-box"
				 bindchange="changeKey"
				 range-key="status_name"
				 value="statusIndex"
				 range="{{statusList}}"
				>
					<view class="picker">当前选择</view>
				</picker>
			</view>

			<view class="select-item" bindtap="searchReset">
				<view>重置</view>
				<image class="reset-icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/weclient/reset_icon.png" />
			</view>
		</view>

		<view class="content-list" wx:if="{{list.length > 0}}">
			<view
			 class="item {{item.status === 1 ? 'item-bg' : ''}}"
			 wx:for="{{list}}"
			 wx:key="index"
			 data-item="{{item}}"
			 bindtap="goDetail"
			>

				<view class="status-box-left">
					<image class="bg-icon" src="{{statusList[item.status].status_bg}}" />
					<view class="txt status-txt">{{statusList[item.status].status_name}}</view>
				</view>
				<!-- <view
				 class="status-box-right"
				 data-item="{{item}}"
				 catchtap="onComments"
				 wx:if="{{item.status === 1 || item.status === 2}}"
				>
					<image class="edit-icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/edit_icon.png" />
					<view class="txt" wx:if="{{item.is_comment === 2}}">我要评价</view>
					<view class="txt" wx:else>查看评价</view>
				</view> -->

				<view class="form-item m-t-45">
					<view class="label">邀约时间</view>
					<view class="value">{{item.create_time_str}}</view>
				</view>
				<view class="form-item m-t-15">
					<view class="label">到店时间</view>
					<view class="value">{{item.reserve_time_str}}</view>
				</view>
				<view class="form-item m-t-15">
					<view class="label">顾客姓名</view>
					<view class="value">{{item.user_name}}</view>
				</view>
				<view class="form-item m-t-15">
					<view class="label">服务名称</view>
					<view class="value">{{item.reserve_name}}</view>
				</view>
				<view class="form-item m-t-15">
					<view class="label">邀约导购</view>
					<view class="value">{{item.member_name}}</view>
				</view>
				<view class="form-item m-t-15">
					<view class="label">邀约门店</view>
					<view class="value">{{item.store_name}}</view>
				</view>
				<view class="form-item m-t-15">
					<view class="label">客户留言</view>
					<view class="value">{{item.user_remark || "无"}}</view>
				</view>
			</view>
			<!-- 自定义加载中 -->
			<custom-loading isLoading="{{isLoading}}" hasMore="{{hasMore}}" />
		</view>
		<view wx:if="{{list.length === 0}}" class="height-100">
			<mp-empty center="{{true}}" slogan="暂无数据" icon="order" />
		</view>
	</block>

	<invite-date
	 wx:if="{{showTime && dateModel}}"
	 timeObj="{{timeObj}}"
	 bindsumbit="timeSumbit"
	 bindclose="closeModel"
	/>
</view>


<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
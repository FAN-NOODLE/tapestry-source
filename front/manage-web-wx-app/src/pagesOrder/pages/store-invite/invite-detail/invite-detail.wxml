<view class="page-invite-detail">
  <view class="content" wx:if="{{!showLoading}}">
    <view class="top-status {{selectServer.reserve_img ? 'has-image' : ''}}">
      <image wx:if="{{selectServer.reserve_img}}" class="top-img" src="{{selectServer.reserve_img}}" />
      <view class="status-box">
        <image class="bg-icon" src="{{statusList[detail.status].status_bg}}" />
        <view class="txt">{{statusList[detail.status].status_name}}</view>
      </view>
    </view>
    <view class="form-item flex-start-center has-line">
      <view class="label flex-start-center">
        <image class="icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/icon-01.png" />
        <view>顾客姓名</view>
      </view>
      <view class="value font-500">{{detail.user_name}}</view>
    </view>
    <view class="form-item flex-start-center has-line">
      <view class="label flex-start-center">
        <image class="icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/icon-04.png" />
        <view>服务类型</view>
      </view>
      <view class="value">
        <view class="{{!selectServer.reserve_name ? 'placeholder' : 'font-500'}}">
          {{selectServer.reserve_name}}
        </view>
      </view>
    </view>
    <view class="form-item flex-start-center has-line">
      <view class="label flex-start-center">
        <image class="icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/icon-03.png" />
        <view>到店时间</view>
      </view>
      <view class="value">
        <view class="font-500" wx:if="{{selectTime.select_name}}">
          {{selectTime.select_name}} {{selectTime.name}}
        </view>
      </view>
    </view>
    <view class="form-item flex-start-center has-line">
      <view class="label flex-start-center">
        <image class="icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/icon-02.png" />
        <view>服务时长</view>
      </view>
      <view class="value">
        <view class="font-500">{{detail.serve_time}}小时</view>
      </view>
    </view>
    <view class="form-item flex-start-center has-line">
      <view class="label flex-start-center">
        <image class="icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/icon-05.png" />
        <view>邀约导购</view>
      </view>
      <view class="value">
        <view class="font-500">{{selectMember.member_name}}</view>
      </view>
    </view>
    <view class="form-item flex-start-center has-line">
      <view class="label flex-start-center">
        <image class="icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/icon-09.png" />
        <view>邀约门店</view>
      </view>
      <view class="value font-500">{{detail.store_name}}</view>
    </view>
    <view class="form-item flex-start-center has-line">
      <view class="label flex-start-center">
        <image class="icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/icon-06.png" />
        <view>门店地址</view>
      </view>
      <view class="value font-500">{{detail.store_address}}</view>
    </view>
    <view class="form-item flex-start-center {{detail.status !== 0 ? 'has-line' : ''}}">
      <view class="label flex-start-center">
        <image class="icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/icon-07.png" />
        <view>导购备注</view>
      </view>
      <view class="value font-500">{{detail.reserve_remark || "无"}}</view>
    </view>

    <view class="form-item flex-start-center" wx:if="{{detail.status !== 0}}">  
      <view class="label flex-start-center"> 
        <image class="icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/message_icon.png" />
        <view>备注信息</view>
      </view>
      <view class="value font-500">{{detail.user_remark || "无"}}</view>
    </view>
    
    <view class="textarea-box" wx:if="{{detail.status === 0}}">
      <textarea maxlength="200" auto-height disabled="{{detail.is_commit === 1}}" data-key="user_remark" bindinput="changeInput"  value="{{user_remark}}" class="textarea" placeholder="如有其他需要，请留言"	placeholder-class="placeholder-textarea" />
    </view>

    <view class="form-item order-box" wx:if="{{isComment}}">
      <view class="order-item item-bottom">
        <view class="item-label">活动安排</view>
        <view class="star-box">
          <view wx:for="{{serviceScoreList}}" wx:key="item" class="star-item">
            <image wx:if="{{item.checked}}" class="star-icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/checked_star_icon.png" />
            <image wx:else class="star-icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/unchecked_star_icon.png" />
          </view>
        </view> 
      </view>  
      <view class="order-item item-bottom">
        <view class="item-label">整体服务</view>
         <view class="star-box">
          <view wx:for="{{storeScoreList}}" wx:key="item" class="star-item">
            <image wx:if="{{item.checked}}" class="star-icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/checked_star_icon.png" />
            <image wx:else class="star-icon" src="https://cdn-cos.coach.com.cn/uploads/2022/v3.0.1/independ/unchecked_star_icon.png" />
          </view>
        </view>
      </view>
      <view class="order-item">
        <view class="item-label ">顾客评价</view>
        <view class="item-value">{{detail.remark || "无"}}</view>
      </view>
    </view>

  </view>
  <view class="footer-btn" wx:if="{{!showLoading && showBottomBtn && (detail.status !== 0 || (detail.status === 0 && detail.is_commit === 0))}}">
    <!-- <view class="btn font-500" wx:if="{{detail.status !== 0}}" data-item="{{detail}}" bindtap="commentService">
      <view wx:if="{{detail.is_comment === 2}}">评价本次邀约服务</view>
      <view wx:else>查看评价内容</view>
    </view> -->
   
    <view class="btn font-500" wx:if="{{detail.status === 0 && detail.is_commit === 0}}" bindtap="confirmOrder">
      确认
    </view>
  </view>
  <!-- 状态说明弹窗 -->
  <message-modal
    show="{{showConfirmModal}}"
    description="{{confirmDesc}}"
    descriptionTwo="{{confirmDescTwo}}"
    bindclose="cancelModel"
    bindcancel="cancelModel"
    bindsure="sureOperation"
    isCatchFun="true"
  ></message-modal>
  <view class="empty" wx:if="{{showLoading}}">
    <image class="empty-icon" src="https://cdn-cos.coach.com.cn/uploads/common/loading-1.gif" />
  </view>
</view>
<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
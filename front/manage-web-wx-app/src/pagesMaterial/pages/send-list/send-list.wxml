<view class="container">
  <!-- header -->
  <view class="header">
    <!-- 素材类型 -->
    <com-tabs tabs="{{tabs}}" active="{{current}}" height="100" line-height="2" line-width="375" bind:change="handleTypeChange"></com-tabs>
  </view>
  <!-- 内容部分 -->
  <view class="content">
    <com-send-material wx:if="{{current===0}}" id="com-send-material" externalIds="{{externalIds}}"></com-send-material>
    <com-goods-material wx:if="{{current===1}}" id="com-goods-material" externalIds="{{externalIds}}" enterType="{{2}}" maxlength="{{9}}"></com-goods-material>
  </view>
</view>
<!-- 系统水印  请勿删除 -->
<mp-watermark></mp-watermark>
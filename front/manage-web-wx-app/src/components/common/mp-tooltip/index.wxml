
<wxs src="./index.wxs" module="computed" />
<!-- 遮罩 -->
<mp-overlay
  wx:if="{{ overlay }}"
  show="{{ show }}"
  z-index="{{ zIndex }}"
  custom-class="overlay-custom-class mp-tooltip__overlay"
  custom-style="{{ overlayStyle }}"
  duration="{{ duration }}"
  catch:click="onClickOverlay"
  lock-scroll="{{ lockScroll }}"
  root-portal="{{ rootPortal }}"
/>
<root-portal wx:if="{{rootPortal}}">
  <view
    wx:if="{{ inited }}"
    class="custom-class mp-tooltip mp-tooltip--{{ placement }}"
    style="{{ computed.popupStyle({ zIndex, customStyle, styles }) }}"
    bind:transitionend="onTransitionEnd"
    catch:touchmove="lockScroll?'noop':''"
  >
    <view class="triangle-custom-class mp-tooltip__triangle"></view>
    <view class="content-custom-class mp-tooltip__content" style="{{ computed.style(contentStyle) }}">
      <rich-text wx:if="{{ content }}" nodes="{{content}}"></rich-text>
      <slot wx:else></slot>
    </view>
  </view>
</root-portal>
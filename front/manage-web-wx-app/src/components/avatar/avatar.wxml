<view  wx:if="{{bubble}}" class="page-avatar" bindtap="previewImage">
    <image class="img" src="{{src}}" mode="aspectFill" lazy-load="true" bindload="imgLoad"></image>
    <slot name="badge"></slot>
</view>

<view wx:if="{{!bubble}}" class="page-avatar" catchtap="previewImage">
    <image class="img" src="{{src}}" mode="aspectFill" lazy-load="true" bindload="imgLoad"></image>
    <slot name="badge"></slot>
</view>

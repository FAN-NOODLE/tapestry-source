<view class="filter-selection">
  <scroll-view class="scroll-view" scroll-y="{{true}}">
    <filter-selection-item
      wx:for="{{selectList}}"
      wx:key="key"
      id="{{item.key}}"
      filterItem="{{item}}"
      itemResult="{{result[item.key]}}"
      bind:showTips="showTips"
      bind:select-date="handleSelectDate"
      bind:change="handleChange"
    />
  </scroll-view>
  <view class="btn-group">
    <view class="reset-btn" bindtap="resetData">重置</view>
    <view class="confirm-btn" bindtap="confirm">确定 <text wx:if="{{count > 0}}">（{{count}}）</text></view>
  </view>
</view>

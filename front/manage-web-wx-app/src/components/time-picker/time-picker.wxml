<!-- components/common/mp-datetime-picker/index.wxml -->
<wxs module="computed" src="./time-picker.wxs"></wxs>

<mp-popup show="{{show}}" round position="bottom" z-index="1000" bind:close="handleCancel">
		<view class="popup">
				<!-- <view class="popup__close" bind:tap="handleCancel"></view> -->
				<view class="popup__title">{{title}}</view>
				<view class="popup__content">
						<view class="title">
								<view wx:for="{{types}}" wx:key="index">{{item}}</view>
						</view>
						<view class="date">
								<picker-view indicator-style="height: 50px;" style="width: 100%; height: 250px;" value="{{columnIndex}}" bindchange="handleChange" bindpickstart="handleStart" bindpickend="handleEnd">
										<picker-view-column wx:for="{{columns}}" wx:for-item="column" wx:key="index">
												<view wx:for="{{column.values}}" wx:key="index" style="line-height: 50px; text-align: center;">
														{{item}}
												</view>
										</picker-view-column>
								</picker-view>
						</view>
				</view>
				<mp-footer fixed="{{false}}">
					<view class="popup__footer">
							<view class="btn plain" bind:tap="handleCancel">取消</view>
							<view class="btn" bind:tap="handleConfirm">确定</view>
					</view>
				</mp-footer>
		</view>
</mp-popup>
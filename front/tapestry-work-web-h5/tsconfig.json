{
  "compilerOptions": {
    "target": "esnext", // 编译输出目标 ES 版本
    "module": "esnext", // 采用的模块系统
    "strict": false, // 以严格模式解析
    "jsx": "preserve", // 在.tsx文件里支持JSX
    "importHelpers": true, // 导入辅助函数
    "moduleResolution": "node", // 如何处理模块
    "experimentalDecorators": true, // 启用装饰器
    "allowJs": true, // 允许编译javascript文件
    "esModuleInterop": true,
    "noImplicitThis": false, //忽略this问题
    "allowSyntheticDefaultImports": true, // 允许从没有设置默认导出的模块中默认导入
    "noImplicitAny": false, // 在表达式和声明上有隐含的any类型时报错
    "sourceMap": true,
    "pretty": true,
    "baseUrl": ".",
    "types": [
      "node",
      "webpack-env",
      "vue/types",
    ],
    "typeRoots": [
      "node_modules/@types",
    ],
    "paths": {
      "@/*": [
        "src/*"
      ],
    },
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "es5",
      "es6",
      "es7",
      "es2015.promise",
      "scripthost"
    ],
    "strictPropertyInitialization": false
  },
  "include": [
    "src/**/*",
    "src/**/*.vue"
  ],
  "exclude": [
    "./node_modules"
  ],
  "rules": {
    "interface-name": [
      false,
      "never-prefix"
    ]
  }
}
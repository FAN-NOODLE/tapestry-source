SELECT
   s.`id`,
   s.`enterprise_id`,
   s.`group_id`,
   s.`created_at`,
   s.`admin_id`,
   s.`type`,
   s.`status` source_status,
   s.`start_time`,
   s.`end_time`,
   s.created_at,
   img.name,
   img.url,
   img.ext,
   img.size,
   img.`media_id`,
   img.`media_expire_time`,
   img.`media_status`,
   scr.`type` as source_type,
   IFNULL(group_concat(sc.`name`), "") AS category_names,
   IFNULL(group_concat(sc.`id`), "") AS category_ids
FROM source_image as img
LEFT JOIN source as s on img.id = s.id
LEFT JOIN source_category_relation as scr on scr.source_id = img.id
LEFT JOIN source_category as sc on sc.id = scr.category_id

WHERE
s.enterprise_id  = :enterprise_id

{{if .cond.CategoryIds}}
    AND scr.category_id IN ({{WhereIn .cond.CategoryIds}})
{{end}}

{{if .cond.GroupIDList}}
AND s.group_id IN ({{WhereIn .cond.GroupIDList}})
{{end}}

{{if .cond.JustMe}}
AND admin_id = :admin_id
{{end}}
{{if .cond.Keyword}}
AND img.name LIKE '%{{SafeStr .cond.Keyword}}%'
{{end}}
{{if and .cond.CreateStart .cond.CreateEnd}}
AND s.created_at BETWEEN :create_start AND :create_end
{{end}}

{{if ne .cond.MediaExpireTime 0}}
 AND (img.`media_expire_time` = 0 OR `img`.`media_expire_time` < {{.cond.MediaExpireTime}})
{{end }}

{{if ne .cond.SourceStatus 2}}
    AND s.status = {{.cond.SourceStatus}}
{{end}}

{{if ne .cond.IsUse 1}}
    AND s.start_time <= {{.cond.NowTime}} AND s.end_time >= {{.cond.NowTime}}
{{end}}

AND s.deleted_at = 0
AND img.deleted_at = 0
GROUP BY img.id

{{if and .cond.Order .cond.Sort}}
    ORDER BY s.{{.cond.Order}} {{.cond.Sort}}
{{else}}
    ORDER BY img.id DESC
{{end}}

LIMIT {{.page.Offset}}, {{.page.Limit}}

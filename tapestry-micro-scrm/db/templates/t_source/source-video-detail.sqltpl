SELECT s.`id`,
       s.enterprise_id,
       s.`group_id`,
       s.`created_at`,
       s.`admin_id`,
       s.`type`,
       IFNULL(sub.name,"") name,
       IFNULL(sub.url, "") url,
       IFNULL(sub.cover_url, "") cover_url,
       IFNULL(sub.ext, "") ext,
       IFNULL(sub.status, 0) status,
       IFNULL(sub.size, 0) size,
          s.`start_time`,
          s.`end_time`
FROM `source` s
LEFT JOIN source_video sub ON s.id = sub.id

WHERE s.id = ? AND s.deleted_at=0

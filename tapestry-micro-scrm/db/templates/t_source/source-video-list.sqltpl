SELECT
    s.`id`,
    s.enterprise_id,
    s.`group_id`,
    s.`created_at`,
    s.`admin_id`,
    s.`type`,
    s.`status` source_status,
    s.`start_time`,
    s.`end_time`,
    IFNULL(sub.name,"") name,
    IFNULL(sub.url, "") url,
    IFNULL(sub.cover_url, "") cover_url,
    IFNULL(sub.ext, "") ext,
    IFNULL(sub.status, 0) status,
    IFNULL(sub.size, 0) size,
    sub.`media_id`,
    sub.`media_expire_time`,
    sub.`media_status`,
    sc.`name` as category_name,
    scr.`type` as source_type,
    IFNULL(group_concat(sc.`name`), "") AS category_names,
    IFNULL(group_concat(sc.`id`), "") AS category_ids
FROM `source_video` sub
LEFT JOIN source s ON s.id = sub.id
LEFT JOIN source_category_relation as scr on scr.source_id = sub.id
LEFT JOIN source_category as sc on sc.id = scr.category_id

WHERE s.enterprise_id = :enterprise_id
AND s.`deleted_at` = 0

{{if .cond.CategoryIds}}
    AND scr.category_id IN ({{WhereIn .cond.CategoryIds}})
{{end}}

{{if .cond.GroupIDList}}
    AND s.group_id IN ({{WhereIn .cond.GroupIDList}})
{{end}}

{{if and .cond.CreateStart .cond.CreateEnd}}
    AND s.created_at BETWEEN :create_start AND :create_end
{{end}}
{{if and .cond.JustMe .cond.AdminID}}  AND s.admin_id = :admin_id {{end}}

{{if .cond.Keyword}}
    AND   sub.name LIKE "%{{SafeStr .cond.Keyword}}%"
{{end}}
{{if ne .cond.MediaExpireTime 0}}
 AND (sub.`media_expire_time` = 0 OR `sub`.`media_expire_time` < {{.cond.MediaExpireTime}})
{{end }}

{{if ne .cond.SourceStatus 2}}
    AND s.status = {{.cond.SourceStatus}}
{{end}}

GROUP BY sub.id

{{if and .cond.Order .cond.Sort}}
    ORDER BY s.{{.cond.Order}} {{.cond.Sort}}
{{else}}
    ORDER BY sub.id DESC
{{end}}

limit {{.page.Offset}}, {{.page.Limit}}

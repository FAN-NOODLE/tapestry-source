SELECT
	wgc.id,
	wgc.name,
	wgc.member_num,
	wgc.owner_member_id,
	m.name as owner_member
FROM
	`work_group_chat` as wgc
	LEFT JOIN `members` as m ON wgc.owner_member_id = m.id
WHERE
	wgc.enterprise_id = {{.cond.EnterpriseID}}
	AND wgc.deleted_at = 0
	AND wgc.type = 1
	{{if ne .cond.GroupName ""}}
        AND wgc.name like '%{{SafeStr .cond.GroupName}}%'
    {{end}}
    {{if gt .cond.ChatIDCount 0}}
        AND wgc.id IN ({{WhereIn .cond.ChatIDs}})
    {{end}}
    {{if gt .cond.FilterCount 0}}
        AND wgc.id NOT IN ({{WhereIn .cond.Filter}})
    {{end}}
ORDER BY wgc.`id` DESC
{{if ne .page.Limit 0}}
    LIMIT {{.page.Offset}}, {{.page.Limit}}
{{end}}


SELECT 
    wgc.id,
    wgc.enterprise_id,
    chat_id,
    wgc.name,
    if(isnull(wgct.name),'',wgct.name) chat_type_name,
    wgc.type,
    owner_member_id,
    notice,
    create_time,
    status,
    dissolve_time,
    wgc.created_at,
    wgc.updated_at,
    wgc.deleted_at,
    member_num,
    channel_id,
    chat_type_id,
    chat_target,
    operator_member_id
FROM work_group_chat wgc left join work_group_chat_type wgct on wgc.chat_type_id=wgct.id
WHERE wgc.enterprise_id = :enterprise_id
{{if ne .cond.ChatID ""}} AND chat_id = :chat_id {{end}}
{{/* chat_id 支持批量查询 */}}
{{if .cond.ChatIds}} and wgc.chat_id in ({{WhereIn .cond.ChatIds}}) {{end}}
{{if ne .cond.Owner 0}} AND owner_member_id = :owner {{end}}
{{if ne .cond.ChannelID 0}} and channel_id = :channel_id {{end}}
{{if ne .cond.ChatTypeID 0}} and chat_type_id = :chat_type_id {{end}}
{{if ne .cond.ChatName ""}} and wgc.name like '%{{.cond.ChatName}}%' {{end}}
{{if .cond.OperatorIds}} and operator_member_id in ({{WhereIn .cond.OperatorIds}}) {{end}}
and wgc.create_time < {{.cond.EndAt}} and wgc.create_time >= {{.cond.StartAt}}
AND wgc.deleted_at = 0 AND dissolve_time = 0 order by create_time desc

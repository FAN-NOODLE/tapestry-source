SELECT
    m.id as member_id,
	m.name as user_name,
	d.id as department_id,
	d.name as department_str
FROM
	members AS m
LEFT JOIN
    member_departments AS md ON m.id = md.member_id
LEFT JOIN
    departments AS d ON d.id = md.department_id
where
    1 =1
And
    m.deleted_at = 0
AND
    md.deleted_at = 0
AND
    d.deleted_at = 0
And
    m.id in ({{WhereIn .MemberIds }})
AND
    d.`enterprise_id` = :enterprise_id
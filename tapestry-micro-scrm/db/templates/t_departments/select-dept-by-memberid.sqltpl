SELECT
	departments.`id`,
	`name`,
	`third_id`,
	`third_parent_id`,
	`order`
FROM
	departments
	LEFT JOIN member_departments ON member_departments.department_id = departments.id
WHERE
    member_departments.`deleted_at` = 0 AND departments.`deleted_at` = 0
AND
    member_departments.member_id =  {{.cond.MemberID}}
SELECT
    wr.*,
    m.`userid`,
    wu.`openid`
FROM
    work_external_user_relation wr
LEFT JOIN
    members m
ON
    wr.`member_id` = m.`id`
LEFT JOIN
    micro_scrm_enterprise_{{.enterprise_id}}.`wx_user_corp_external` wu
ON
    wu.`id` = wr.`work_external_user_id`
WHERE
    wr.`id` = ?
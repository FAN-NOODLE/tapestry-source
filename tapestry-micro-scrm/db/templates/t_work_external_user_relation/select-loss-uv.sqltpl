SELECT count(*) AS relation_num FROM ( SELECT work_external_user_id FROM work_external_user_relation WHERE ( ( member_deleted_time >= :start_at AND member_deleted_time <= :end_at AND relation_status = 1 ) OR ( external_deleted_time >= :start_at AND external_deleted_time <= :end_at AND relation_status = 2 ) OR ( id IN ( SELECT id FROM ( SELECT id, LEAST( member_deleted_time, external_deleted_time ) AS c FROM work_external_user_relation WHERE relation_status = 3 AND enterprise_id = :enterprise_id AND deleted_at = 0 HAVING c >= :start_at AND c <= :end_at ) id_tmp ) ) ) AND relation_status IN ( 1, 2, 3 ) AND enterprise_id = :enterprise_id AND deleted_at = 0 AND work_external_user_id NOT IN ( SELECT work_external_user_id FROM work_external_user_relation WHERE createtime <= :end_at AND relation_status = 0 AND enterprise_id = :enterprise_id AND deleted_at = 0 ) GROUP BY work_external_user_id ) tmp_table;
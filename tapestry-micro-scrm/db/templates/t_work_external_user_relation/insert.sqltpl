INSERT INTO `work_external_user_relation` (
	`id`,
	`enterprise_id`,
	`work_external_user_id`,
	`member_id`,
	`remark`,
	`description`,
	`createtime`,
	`remark_corp_name`,
	`remark_mobiles`,
	`add_way`,
	`state`,
	`oper_userid`,
	`relation_status`,
	`created_at`,
	`updated_at`
)
VALUES
	(   : id,
		: enterprise_id,
		: work_external_user_id,
		: member_id,
		: remark,
		: description,
		: createtime,
		: remark_corp_name,
		: remark_mobiles,
		: add_way,
		: state,
		: oper_userid,
		: relation_status,
		: created_at,
	    : updated_at,
	    : user_id,
	    : unionid,
	);
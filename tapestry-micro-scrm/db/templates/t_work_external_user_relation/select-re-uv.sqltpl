SELECT count(*) AS relation_num FROM ( SELECT work_external_user_id FROM work_external_user_relation WHERE `createtime` <= :end_at AND `enterprise_id` = :enterprise_id AND deleted_at = 0 AND ( ( `member_deleted_time` > :end_at AND `member_deleted_time` != 0 AND relation_status = 1 ) OR ( `external_deleted_time` > :end_at AND `external_deleted_time` != 0 AND relation_status = 2 ) OR (( `external_deleted_time` > :end_at AND `member_deleted_time` > :end_at ) AND external_deleted_time != 0 AND member_deleted_time != 0 AND relation_status = 3 ) OR `relation_status` = 0 ) GROUP BY work_external_user_id ) tmp_table;
UPDATE `sms_template` SET
{{if ne .cond.Status 0}}
    `status` = :status,
{{end}}
{{if ne .cond.TemplateName ""}}
    `template_name` = :template_name,
{{end}}
{{if ne .cond.TemplateSignId 0}}
    `template_sign_id` = :template_sign_id,
{{end}}
{{if ne .cond.MessageTemplate ""}}
    `message_template` = :message_template,
{{end}}
{{if ne .cond.TemplateContent ""}}
    `template_content` = :template_content,
{{end}}
{{if ne .cond.TemplateHtml ""}}
    `template_html` = :template_html,
{{end}}
{{if ne .cond.FailReason ""}}
    `fail_reason` = :fail_reason,
{{end}}
{{if ne .cond.MessageStr ""}}
    `message_str` = :message_str,
{{end}}
`updated_at` = :updated_at
WHERE
deleted_at = 0
{{if ne .cond.Id 0}}
   And `id` = :id
{{end}}
{{if ne .cond.TemplateId 0}}
   And `template_id` = :template_id
{{end}}
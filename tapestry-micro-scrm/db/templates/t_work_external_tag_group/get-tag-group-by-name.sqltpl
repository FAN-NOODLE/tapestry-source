SELECT
    TG.`id`,
    TG.`enterprise_id`,
    TG.`group_id`,
    TG.`group_name`,
    TG.`order`,
    TG.`create_time`,
    TG.`created_at`,
    TG.`updated_at`,
    TG.`deleted_at`
FROM
    `work_external_tag_group` TG
WHERE
    TG.`enterprise_id` = :enterprise_id
    AND TG.`group_name` = :group_name
    AND TG.`deleted_at` = 0
select
  `id`,
  `spu_id`,
  `source_id`,
  `spu_name`,
  `spu_sn`,
  `short_title`,
  `sell_point`,
  `sales`,
  `status`,
  `category_id`,
  `category_name`,
  `create_time`,
  `enterprise_id`,
  `picture`,
  `default_attribute`,
  `created_at`,
  `updated_at`,
  `deleted_at`
from `goods_spu`
where
    `enterprise_id` = ?
and
    `spu_id` = ?
and
    `deleted_at` = ?
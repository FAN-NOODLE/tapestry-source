UPDATE `members` SET
`name` = :name, `avatar` = :avatar, `mobile` = :mobile, `gender` = :gender, `email` = :email, `position` = :position,
`enterprise_id` = :enterprise_id, `thumb_avatar` = :thumb_avatar, `qr_code` = :qr_code, `address` = :address, `status` = :status, `updated_at` = :updated_at
WHERE `id` = :id


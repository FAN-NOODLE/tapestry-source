SELECT members.`id`, members.`userid`, members.`name`, members.`mobile`, members.`gender`, members.`email`, members.`avatar`, members.`thumb_avatar`, members.`telephone`, members.`alias`, members.`status`, members.`qr_code`, members.`address`, members.`open_userid`, members.`enterprise_id`, members.`created_at`, members.`updated_at`, members.`position`, IFNULL(GROUP_CONCAT(departments.`name` SEPARATOR ';'),"") as `forms`
FROM members
LEFT JOIN member_departments ON members.`id` = member_departments.`member_id`
LEFT JOIN departments ON member_departments.`department_id` = departments.`id`
WHERE members.`enterprise_id` = :enterprise_id AND members.`deleted_at` = 0 AND member_departments.`deleted_at` = 0 AND departments.`deleted_at` = 0
{{if ne .cond.DepartmentID 0}}
AND member_departments.`department_id` = :department_id
{{end}}
{{if ne .cond.Status 0}}
AND members.`status` = :status
{{end}}
{{if ne .cond.Mobile ""}}
AND members.`mobile` = :mobile
{{end}}
{{if ne .cond.Userid ""}}
AND members.`userid` = :userid
{{end}}
{{if ne .cond.Name ""}}
AND members.`name` like :name
{{end}}
{{if ne .cond.UserIDCount 0}}
AND members.`userid` IN ({{WhereIn .cond.UserIDs}})
{{end }}
{{if ne .cond.IDCount 0}}
AND members.`id` IN ({{WhereIn .cond.IDs}})
{{end }}
GROUP BY members.`id`
{{if ne .page.Limit 0}}
LIMIT {{.page.Offset}}, {{.page.Limit}}
{{end}};

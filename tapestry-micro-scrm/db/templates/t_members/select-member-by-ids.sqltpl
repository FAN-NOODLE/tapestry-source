SELECT
	`id`,
	`userid`,
	`name`,
	`mobile`,
	`position`,
	`gender`,
	`email`,
	`avatar`,
	`thumb_avatar`,
	`telephone`,
	`alias`,
	`status`,
	`qr_code`,
	`address`,
	`open_userid`,
	`enterprise_id`,
	`created_at`,
	`updated_at`,
	`deleted_at`
FROM
	`members`
WHERE
	1 = 1
	AND `deleted_at` = 0
	AND `id` IN ({{WhereIn .ids }})
	AND `enterprise_id` = :enterprise_id
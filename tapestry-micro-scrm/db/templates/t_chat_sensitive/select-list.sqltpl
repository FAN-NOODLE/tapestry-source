SELECT id, enterprise_id, sensitive_text, sensitive_type, trigger_num, created_at
FROM `chat_sensitive`
WHERE `enterprise_id` = :enterprise_id AND `deleted_at` = 0
{{if .cond.SensitiveText}}
AND `sensitive_text` LIKE "%{{SafeStr .cond.SensitiveText}}%"
{{end}}
ORDER BY `sensitive_type`, `created_at` DESC
{{if ne .page.Limit 0}}
LIMIT {{.page.Offset}}, {{.page.Limit}}
{{end}};

SELECT
   `id`,
   `enterprise_id`,
   `activity_id`,
   `fission_user_id`,
   `assistant_user_id`,
   `external_user_id`,
   `member_id`,
   `add_member_status`,
   `add_member_at`,
   `join_chat_group_status`,
   `join_chat_group_at`,
   `score`,
   `created_at`,
   `updated_at`,
   `deleted_at`
FROM
	`fission_assistant_records`
WHERE
    deleted_at =0
    AND assistant_user_id = ?
    AND member_id = ?

select
  `id`,
  `enterprise_id`,
  `name`,
  `desc`,
  `status`,
  `channel_id`,
  `start_time`,
  `end_time`,
  `exchange_end_time`,
  `fission_type`,
  `cond_type`,
  `mutual_type`,
  `drainage_welcomes_id`,
  `contact_id`,
  `user_num`,
  `fission_num`,
  `run_away_num`,
  `join_group_num`,
  `leave_group_num`,
  `created_at`,
  `updated_at`,
  `deleted_at`
from fission_activity
where
    enterprise_id = ?
and
    id = ?
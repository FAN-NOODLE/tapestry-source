SELECT
	`id`,
	`enterprise_id`,
	`name`,
	`desc`,
	`status`,
	`channel_id`,
	`start_time`,
	`end_time`,
	`exchange_end_time`,
	`fission_type`,
	`cond_type`,
	`mutual_type`,
	`user_num`,
	`fission_num`,
	`run_away_num`,
	`join_group_num`,
	`leave_group_num`,
	`drainage_welcomes_id`
FROM
    `fission_activity`
WHERE
    contact_id = ?
and
    enterprise_id = ?
and
    deleted_at = 0


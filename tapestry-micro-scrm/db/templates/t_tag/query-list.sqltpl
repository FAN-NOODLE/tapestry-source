select
  `id`,
  `enterprise_id`,
  `tag_id`,
  `tag_name`,
  `tag_group_id`,
  `created_at`,
  `updated_at`,
  `deleted_at`
from
    `tag`
where
    `enterprise_id` = {{.cond.EnterpriseID}}
{{if .cond.Search}}
and
    `tag_name` like "%{{SafeStr .cond.Search}}%"
{{end}}
and
    `deleted_at` = 0
LIMIT
    {{.page.Offset}}, {{.page.Limit}}
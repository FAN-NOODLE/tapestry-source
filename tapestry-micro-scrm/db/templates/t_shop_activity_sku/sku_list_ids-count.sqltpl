SELECT
    count(*)
FROM
    `shop_activity_sku` a
    LEFT JOIN goods_sku g ON a.sku_id = g.sku_id
WHERE
    a.`enterprise_id` = {{.cond.EnterpriseID}}
    AND g.`enterprise_id` = {{.cond.EnterpriseID}}
    AND a.`deleted_at` = 0
    AND g.`deleted_at` = 0
    AND g.id IS NOT NULL
    {{$activityLen := len .cond.ActivityIds}}
    {{if gt  $activityLen 0}}
       AND `shop_activity_id` IN ({{WhereIn .cond.ActivityIds}})
   {{end}}
   {{if gt .cond.Status 0}}
        AND a.`sku_status` = {{.cond.Status}}
   {{end}}
   {{if ne .cond.GoodsName ""}}
        AND `sku_name` like '%{{SafeStr .cond.GoodsName}}%'
   {{end}}

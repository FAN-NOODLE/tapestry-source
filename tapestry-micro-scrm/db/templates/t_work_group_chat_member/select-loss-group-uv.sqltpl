SELECT count(*) AS relation_num FROM (SELECT userid FROM work_group_chat_member WHERE leave_time >= :start_at AND leave_time <= :end_at AND enterprise_id = :enterprise_id AND type = 2 AND `status` = 2 AND deleted_at = 0 AND userid NOT IN ( SELECT userid FROM work_group_chat_member WHERE (( join_time >= :start_at AND join_time <= :end_at AND enterprise_id = :enterprise_id AND `status` = 1 ) OR ( leave_time >= :end_at AND `status` = 2 AND join_time >= :start_at AND join_time <= :end_at ) ) AND deleted_at = 0 AND type = 2 AND enterprise_id = :enterprise_id ) GROUP BY userid ) tmp_table
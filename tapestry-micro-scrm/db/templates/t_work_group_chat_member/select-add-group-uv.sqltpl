SELECT count(*) AS relation_num FROM ( SELECT userid FROM work_group_chat_member WHERE join_time >= :start_at AND join_time <= :end_at AND type = 2 AND STATUS IN ( 1, 2 ) AND enterprise_id = :enterprise_id AND deleted_at = 0 AND userid NOT IN ( SELECT userid FROM work_group_chat_member WHERE ( join_time < :start_at  AND type = 2 AND STATUS = 1 ) AND enterprise_id = :enterprise_id AND deleted_at = 0 GROUP BY userid ) GROUP BY userid ) tmp_table
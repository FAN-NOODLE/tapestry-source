SELECT * FROM `work_group_chat_member` WHERE `enterprise_id` = :enterprise_id AND `deleted_at` = :deleted_at
{{if ne .cond.GroupChatID 0}}
AND `group_chat_id` = :group_chat_id
{{end }}

{{if ne .cond.GroupChatIdCount 0}}
AND `group_chat_id` IN ({{WhereIn .cond.ChatGroupIds}})
{{end }}

{{if ne .page.Limit 0}}
LIMIT {{.page.Offset}}, {{.page.Limit}}
{{end}};
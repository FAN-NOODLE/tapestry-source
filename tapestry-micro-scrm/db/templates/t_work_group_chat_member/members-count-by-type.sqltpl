select count(1) total_count
from work_group_chat_member wgcm inner join
     work_group_chat wgc on wgcm.group_chat_id=wgc.id
where wgcm.enterprise_id = :enterprise_id and wgc.chat_id = :chat_id
    {{if eq .cond.MemberType 1}}
  and join_time >= :sts and join_time < :ets and wgcm.deleted_at = 0
    {{else if eq .cond.MemberType 2}}
  and leave_time >= :sts and leave_time < :ets and wgcm.status = 2
    {{else}}
  and leave_time = 0 and wgcm.status = 1 and wgcm.deleted_at = 0 and join_time < :ets
    {{end}}
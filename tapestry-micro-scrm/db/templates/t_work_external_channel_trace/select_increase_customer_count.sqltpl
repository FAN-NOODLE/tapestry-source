SELECT
	count(`external_user_id`)  as count
FROM
	`work_external_channel_trace_{{.cond.EnterpriseID}}`
WHERE
	`join_time` >= :start_time
	AND `join_time` < :end_time
	AND `enterprise_id` = :enterprise_id
    AND `add_channel` = :channels_state
	AND (`last_leave_time` = 0 OR `last_leave_time` < :start_time)

UPDATE
    `fission_user`
SET
    {{if .cond.UserNum}}
    `user_num` = `user_num` + {{.cond.UserNum}},
    {{end}}
    {{if .cond.FissionNum}}
    `fission_num` = `fission_num` + {{.cond.FissionNum}},
    {{end}}
    {{if .cond.RunAwayNum}}
    `run_away_num` = `run_away_num` + {{.cond.RunAwayNum}},
    {{end}}
    {{if .cond.JoinGroupNum}}
    `join_group_num` = `join_group_num` + {{.cond.JoinGroupNum}},
    {{end}}
    {{if .cond.LeaveGroupNum}}
    `leave_group_num` = `leave_group_num` + {{.cond.LeaveGroupNum}},
    {{end}}
    {{if .cond.TotalAssistantNum}}
    `total_assistant_num` = `total_assistant_num` + {{.cond.TotalAssistantNum}},
    {{end}}
    {{if .cond.CurAssistantNum}}
    `cur_assistant_num` = `cur_assistant_num` + {{.cond.CurAssistantNum}},
    {{end}}
    `updated_at` = {{.cond.UpdateAt}}
WHERE
	`id` = ?
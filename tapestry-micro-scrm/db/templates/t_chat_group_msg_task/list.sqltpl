select
  chat_group_msg_task.`id`,
  chat_group_msg_task.`enterprise_id`,
  chat_group_msg_task.`name`,
  chat_group_msg_task.`type`,
  chat_group_msg_task.`send_type`,
  chat_group_msg_task.`status`,
  chat_group_msg_task.`task_status`,
  chat_group_msg_task.`send_time`,
  chat_group_msg_task.`last_send_msg`,
  chat_group_msg_task.`content`,
  chat_group_msg_task.`created_at`,
  chat_group_msg_task.`updated_at`,
  chat_group_msg_task.`deleted_at`,
  IFNULL(GROUP_CONCAT(distinct members.`name` SEPARATOR ';'),'') as `members`
from
    chat_group_msg_task
    left join chat_group_msg_task_member on chat_group_msg_task_member.msg_task_id = chat_group_msg_task.id
    left join members on members.id = chat_group_msg_task_member.member_id
where
    chat_group_msg_task.`enterprise_id` = {{.cond.EnterpriseID}}
    AND chat_group_msg_task.`deleted_at` = 0
    AND chat_group_msg_task_member.`deleted_at` = 0
{{if ne .cond.Name ""}}
    AND chat_group_msg_task.name LIKE "%{{SafeStr .cond.Name}}%"
{{end}}
{{if ne .cond.MemberID 0}}
    AND chat_group_msg_task_member.member_id = {{.cond.MemberID}}
{{end}}
{{if ne .cond.SendType 0}}
    AND chat_group_msg_task.send_type = {{.cond.SendType}}
{{end}}
{{if ne .cond.Status 0}}
    AND chat_group_msg_task.status = {{.cond.Status}}
{{end}}
{{if ne .cond.StartAt 0}}
    AND chat_group_msg_task.last_send_msg > {{.cond.StartAt}}
{{end}}
{{if ne .cond.EndAt 0}}
    AND chat_group_msg_task.last_send_msg < {{.cond.EndAt}}
{{end}}
GROUP BY chat_group_msg_task.id
ORDER BY chat_group_msg_task.id DESC
{{if ne .page.Limit 0}}
    LIMIT {{.page.Offset}}, {{.page.Limit}}
{{end}};


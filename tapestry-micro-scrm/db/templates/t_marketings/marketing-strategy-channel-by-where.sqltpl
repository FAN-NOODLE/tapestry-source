SELECT
    `id`,
    `strategy_id`,
    `channel_type`,
    `junior_id`,
    `content`,
    `order`,
    `created_at`,
    `updated_at`,
    `deleted_at`
FROM
    marketing_strategy_channels
WHERE
    strategy_id = {{.cond.StrategyID}} AND
    channel_type = {{.cond.ChannelType}} AND
    deleted_at = 0

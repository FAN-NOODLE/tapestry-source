SELECT
`id`, `user_id`, `enterprise_id`, `union_id`, `strategy_id`, `channel_type`, `relation_id`, `channel_id`, `status`, `user_name`, `mobile`, `address_user_name`, `order_id`, `start_time`, `end_time`,
       `created_at`, `updated_at`, `deleted_at`, `external_userid`, `msg_id`
FROM
`marketing_strategy_records_v2`
WHERE
`start_time` <= :current_time AND `status` = 1
AND
`strategy_id` = :strategy_id

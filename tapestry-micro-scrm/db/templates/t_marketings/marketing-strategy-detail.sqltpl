SELECT marketing_strategies.`id`,
marketing_strategies.`strategy_name`,
marketing_strategies.`customer_group_id`,
marketing_strategies.`enterprise_id`,
marketing_strategies.`admin_id`,
marketing_strategies.`strategy_type`,
marketing_strategies.`strategy_method`,
marketing_strategies.`start_time`,
marketing_strategies.`end_time`,
marketing_strategies.`strategy_policy`,
marketing_strategies.`strategy_status`,
marketing_strategies.`is_finished`,
marketing_strategies.`is_notice`,
marketing_strategies.`status`,
marketing_strategies.`history_status`,
marketing_strategies.`mobile`,
marketing_strategies.`setting_day`,
marketing_strategies.`history_status`,
marketing_strategies.`created_at`,
marketing_strategies.`updated_at`,
marketing_strategies.`abnormal_pause`,
marketing_strategy_conditions.`condition`,
marketing_strategy_conditions.`inner_condition`,
marketing_strategy_conditions.`assign_type`,
marketing_strategy_conditions.`relation_type`,
marketing_strategy_conditions.`belong_type`,
marketing_strategy_conditions.`start_point`,
marketing_strategy_conditions.`end_point`,
marketing_strategy_conditions.`time_interval`,
marketing_strategy_conditions.`time_type`,
marketing_strategy_conditions.`time`,
IFNULL(`ug`.`name`, "") AS `customer_group_name`
 FROM `marketing_strategies`
 LEFT JOIN marketing_strategy_conditions ON marketing_strategy_conditions.`strategy_id` = marketing_strategies.`id`
 LEFT JOIN `user_group` AS `ug` ON `ug`.`id` = `marketing_strategies`.`customer_group_id`
 WHERE marketing_strategies.`id` = ? AND marketing_strategies.`deleted_at` = 0 AND marketing_strategy_conditions.`deleted_at` = 0
SELECT
    `user_id`,
    `enterprise_id`,
    `age`,
    `birthday`,
    `birthday_date`,
    `gender`,
    `mobile`,
    `email`,
    `qq`,
    `describe`,
    `created_at`,
    `updated_at`,
    `deleted_at`
FROM
    `customer_remark_info`
WHERE
    `user_id` = ?
AND
    `deleted_at` = 0;
SELECT name,avatar,work_external_user_relation.member_id,createtime
FROM `work_external_user_relation`
LEFT JOIN members on members.id = work_external_user_relation.member_id
{{if .cond.DepartmentID}}
LEFT JOIN member_departments on member_departments.member_id = work_external_user_relation.member_id
{{end}}
WHERE
`work_external_user_relation`.`enterprise_id` = {{.cond.EnterpriseID}}
AND `work_external_user_id` = {{.cond.UserWorkID}}
{{if .cond.MemberID}}
AND work_external_user_relation.member_id = :member_id
{{end}}
{{if .cond.DepartmentID}}
AND member_departments.department_id = :department_id
AND member_departments.deleted_at = 0
{{end}}
AND work_external_user_relation.relation_status = 0
AND work_external_user_relation.deleted_at = 0
AND members.deleted_at = 0
ORDER BY createtime desc
limit {{.page.Offset}}, {{.page.Limit}};

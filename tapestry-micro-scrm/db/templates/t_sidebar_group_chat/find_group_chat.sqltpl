SELECT
  `id`,
  `enterprise_id`,
  `chat_id`,
  `name`,
  `type`,
  `owner_member_id`,
  `notice`,
  `create_time`,
  `status`,
  `dissolve_time`,
  `created_at`,
  `updated_at`,
  `deleted_at`
FROM
	work_group_chat
WHERE
	work_group_chat.deleted_at = 0
	AND work_group_chat.chat_id = :group_chat_id
	AND work_group_chat.enterprise_id = :enterprise_id
SELECT
    work_group_chat.chat_id,
	work_group_chat_member.group_chat_id,
	work_group_chat_member.unionid,
	work_group_chat_member.join_time,
	work_group_chat_member.leave_time,
	work_group_chat_member.join_scene,
	work_group_chat_member.status,
	LEFT ( from_unixtime(work_group_chat_member.join_time), 10 ) AS join_data_time,
	LEFT ( from_unixtime(work_group_chat_member.leave_time), 10 ) AS leave_data_time
FROM
	work_group_chat
	left join work_group_chat_member on work_group_chat.id = work_group_chat_member.group_chat_id
WHERE
	work_group_chat.deleted_at = 0
	AND work_group_chat.chat_id = :group_chat_id
	AND work_group_chat.enterprise_id = :enterprise_id
	AND work_group_chat_member.type = 2

INSERT INTO micro_scrm_enterprise_{{.enterprise_id}}.wx_app_config
(
  `appid`,
  `app_type`,
  `name`,
  `bind_status`,
  `created_at`,
  `updated_at`
) VALUES
(
  :appid,
  :app_type,
  :name,
  :bind_status,
  :created_at,
  :updated_at
) on duplicate key update
name=:name, 
bind_status=:bind_status,
updated_at=:updated_at
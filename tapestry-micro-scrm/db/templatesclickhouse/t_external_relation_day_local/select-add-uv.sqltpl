select
	uniqExact(external_user_id) AS relation_num
from
	(
	select
		external_user_id,
		min(add_time) as min_add_day
	from
		external_relation_day final
	where
		add_time < :end_at
		and (del_time > :start_at
		or del_time = 0)
		AND corp_id = :corp_id
	group by
		external_user_id ) userb
where
	min_add_day > :start_at
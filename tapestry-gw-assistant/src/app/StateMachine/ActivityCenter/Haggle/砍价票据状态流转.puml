@startuml
scale 600 width


[*] --> 默认状态

state 默认状态 {
    默认状态:1
    默认状态 --> 待支付 : 生成订单
    默认状态 --> 已过期  : 砍价发起过期
}

state 待支付  {
    待支付:2
    待支付 --> 已支付 : 支付订单
    待支付 --> 已取消 : 取消订单
}

state 已过期  {
    已过期:5
}

state 已支付  {
    已支付:3
}

state 已取消  {
    已取消:4
}

已过期 --> [*]
已支付 --> [*]
已取消 --> [*]

@enduml
@startuml
scale 600 width


[*] --> 砍价中

state 砍价中 {
    砍价中:1
    砍价中 --> 砍价成功 : 砍最后一刀
    砍价中 --> 砍价失败  : 砍价发起过期
    砍价中 --> 砍价失败  : 活动下架
    砍价中 --> 票据生成中  : 生成票据
}

state 砍价成功  {
    砍价成功:2
    砍价成功 --> 票据生成中 : 生成票据
    砍价成功 --> 活动过期 : 砍价发起过期
}

state 票据生成中  {
    票据生成中:8
    票据生成中 --> 待支付 : 生成订单
    票据生成中 --> 活动过期 : 砍价发起过期
}

state 待支付  {
    待支付:4
    待支付 --> 已支付 : 支付同步调用
    待支付 --> 已取消 : 取消订单
    待支付 --> 支付完成 : 支付异步回调
}

state 已支付  {
    已支付:9
    已支付 --> 支付完成 : 支付异步回调
}

state 砍价失败  {
    砍价失败:3
}

state 活动过期  {
    活动过期:7
}

state 支付完成  {
    支付完成:5
}

state 已取消  {
    已取消:6
}

砍价失败 --> [*]
活动过期 --> [*]
支付完成 --> [*]
已取消 --> [*]

@enduml